<%# Shared Sidebar Menu - shows links based on user profile capabilities %>
<% profiles = current_user&.assigned_profiles&.pluck(:code) || [] %>
<% caps = current_account&.capabilities || [] %>

<!-- Dashboard -->
<%= link_to admin_dashboard_path, class: nav_link_class(controller.controller_name == "dashboard" && controller.action_name == "index"), data: { turbo: true } do %>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
  </svg>
  <span>Dashboard</span>
<% end %>

<!-- Processos -->
<% if caps.include?("PROCESSO_VIEW") %>
  <div class="nav-section mt-4 mb-2">Processos</div>
  
  <%= link_to admin_processes_path, class: nav_link_class("processes"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
    </svg>
    <span>Lista de Processos</span>
  <% end %>

  <% if caps.include?("PROCESSO_CREATE") %>
    <%= link_to new_admin_process_path, class: nav_link_class("processes", "new"), data: { turbo: true } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      <span>Novo Processo</span>
    <% end %>
  <% end %>
<% end %>

<!-- Diligências -->
<% if caps.include?("DILIGENCIA_CREATE") %>
  <div class="nav-section mt-4 mb-2">Diligências</div>
  
  <%= link_to admin_diligences_path, class: nav_link_class("diligences"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
    </svg>
    <span>Diligências</span>
  <% end %>
<% end %>

<!-- Documentos -->
<% if caps.include?("DOCUMENT_VIEW") %>
  <div class="nav-section mt-4 mb-2">Documentos</div>
  
  <%= link_to admin_documents_path, class: nav_link_class("documents"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
    </svg>
    <span>Documentos</span>
  <% end %>
<% end %>

<!-- Mandados -->
<% if caps.include?("MANDADO_VIEW") %>
  <div class="nav-section mt-4 mb-2">Mandados</div>
  
  <%= link_to admin_mandates_path, class: nav_link_class("mandates"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
    </svg>
    <span>Mandados</span>
  <% end %>
<% end %>

<!-- Evidências -->
<% if caps.include?("evidence.manage".upcase) || caps.include?("EVIDENCE_MANAGE") %>
  <div class="nav-section mt-4 mb-2">Evidências</div>
  
  <%= link_to admin_evidences_path, class: nav_link_class("evidences"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
    </svg>
    <span>Evidências</span>
  <% end %>
<% end %>

<!-- Administração (só ADMIN) -->
<% if caps.include?("USER_MANAGE") %>
  <div class="nav-section mt-4 mb-2">Administração</div>
  
  <%= link_to admin_organizations_path, class: nav_link_class("organizations"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
    </svg>
    <span>Organizações</span>
  <% end %>

  <%= link_to admin_users_path, class: nav_link_class("users"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
    </svg>
    <span>Utilizadores</span>
  <% end %>

  <%= link_to admin_profiles_path, class: nav_link_class("profiles"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
    </svg>
    <span>Perfis</span>
  <% end %>

  <%= link_to admin_capabilities_path, class: nav_link_class("capabilities"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
    </svg>
    <span>Capacidades</span>
  <% end %>
<% end %>

<!-- Auditoria (só ADMIN e DIRECAO_GERAL) -->
<% if caps.include?("AUDIT_VIEW") %>
  <div class="nav-section mt-4 mb-2">Auditoria</div>
  
  <%= link_to admin_audit_path, class: nav_link_class("audit", "index"), data: { turbo: true } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
    </svg>
    <span>Registo de Auditoria</span>
  <% end %>
<% end %>
