<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar Conta — SIP</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            sic: {
              50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
              400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
              800: '#075985', 900: '#0c4a6e', 950: '#082f49',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans antialiased h-screen overflow-hidden">
  <div class="flex h-full">

    <div class="hidden lg:flex lg:w-1/2 relative bg-sic-950 overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs><pattern id="grid2" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/></pattern></defs>
          <rect width="100%" height="100%" fill="url(#grid2)"/>
        </svg>
      </div>
      <div class="absolute top-0 left-0 w-96 h-96 bg-sic-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-sic-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 translate-x-1/2 translate-y-1/2"></div>
      <div class="relative z-10 flex flex-col justify-between p-16 w-full">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-sic-400 to-sic-600 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <span class="text-white text-xl font-bold tracking-tight">SIP</span>
        </div>
        <div class="space-y-6">
          <h1 class="text-4xl font-bold text-white leading-tight">Junta-te à <span class="text-sic-400">equipa</span></h1>
          <p class="text-slate-400 text-lg max-w-md leading-relaxed">Cria a tua conta para aceder à plataforma de gestão de processos.</p>
        </div>
        <div class="flex gap-12">
          <div><div class="text-2xl font-bold text-white">SIC</div><div class="text-sm text-slate-500 mt-1">Segurança Interna</div></div>
          <div><div class="text-2xl font-bold text-white">Angola</div><div class="text-sm text-slate-500 mt-1">República de</div></div>
        </div>
      </div>
    </div>

    <div class="w-full lg:w-1/2 flex items-center justify-center bg-slate-50 px-6 py-12">
      <div class="w-full max-w-md">

        <div class="lg:hidden flex items-center gap-3 mb-8 justify-center">
          <div class="w-10 h-10 bg-gradient-to-br from-sic-500 to-sic-700 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div><span class="text-slate-900 text-xl font-bold">SIP</span><span class="block text-xs text-slate-500">SIC Angola</span></div>
        </div>

        <div class="mb-8">
          <h2 class="text-2xl font-bold text-slate-900">Criar conta</h2>
          <p class="text-slate-500 mt-1">Preenche os dados para te registas</p>
        </div>

        <% if @error %>
          <div class="fb-alert fb-alert fb-alert-error mb-6 flex items-center gap-3">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><%= @error %></span>
          </div>
        <% end %>

        <form method="POST" action="<%= auth_create_account_path %>" class="space-y-5">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

          <div>
            <label for="login" class="fb-label">Utilizador</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <input type="text" name="login" id="login" required
                class="fb-input ps-10"
                placeholder="O teu nome de utilizador"
                value="<%= @login || '' %>">
            </div>
          </div>

          <div>
            <label for="email" class="fb-label">Email institucional</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <input type="email" name="email" id="email" required
                class="fb-input ps-10"
                placeholder="o.teu.email@sic.angola"
                value="<%= @email || '' %>">
            </div>
          </div>

          <div>
            <label for="password" class="fb-label">Palavra-passe</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <input type="password" name="password" id="password" required minlength="8"
                class="fb-input ps-10"
                placeholder="Mínimo 8 caracteres">
            </div>
          </div>

          <div>
            <label for="password_confirmation" class="fb-label">Confirmar palavra-passe</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <input type="password" name="password_confirmation" id="password_confirmation" required
                class="fb-input ps-10"
                placeholder="Repete a palavra-passe">
            </div>
          </div>

          <button type="submit" class="fb-btn fb-btn-primary w-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            Criar conta
          </button>
        </form>

        <p class="mt-8 text-center text-sm text-slate-500">
          Já tens conta?
          <a href="<%= auth_login_path %>" class="font-semibold text-sic-600 hover:text-sic-700 transition-colors">Entrar</a>
        </p>

        <p class="mt-8 text-center text-xs text-slate-400">© 2025 SIP — Serviço de Investigação Criminal</p>
      </div>
    </div>
  </div>
</body>
</html>
