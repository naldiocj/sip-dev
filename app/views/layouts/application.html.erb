<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="turbo-refresh-style" content="morph">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <title><%= content_for(:title) || "SIP — Serviço de Investigação Criminal" %></title>
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
      // Mobile sidebar state
      if (localStorage.getItem('sidebar-mobile-open') === 'true') {
        document.getElementById('sidebar')?.classList.add('mobile-open');
      }
    </script>
  </head>
  <body class="h-full bg-slate-50">
    <% if logged_in? %>
      <!-- Mobile Overlay -->
      <div id="mobile-overlay" class="mobile-overlay hidden" onclick="toggleSidebar()"></div>

      <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="sidebar sidebar-scrollbar overflow-y-auto" id="sidebar">
          <!-- Brand -->
          <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <div class="sidebar-brand-text">SIP</div>
              <div class="sidebar-brand-sub">SIC Angola</div>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <div class="sidebar-section">Principal</div>
            
            <%= link_to admin_dashboard_path, class: nav_link_class("dashboard", "index"), data: { turbo: true } do %>
              <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
              </svg>
              <span class="sidebar-link-text">Dashboard</span>
            <% end %>

            <% if can?(:PROCESSO_VIEW) %>
              <div class="sidebar-section">Processos</div>
              
              <%= link_to admin_processes_path, class: nav_link_class("processes", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                </svg>
                <span class="sidebar-link-text">Listar Processos</span>
              <% end %>

              <% if can?(:PROCESSO_CREATE) %>
                <%= link_to new_admin_process_path, class: nav_link_class("processes", "new"), data: { turbo: true } do %>
                  <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  <span class="sidebar-link-text">Novo Processo</span>
                <% end %>
              <% end %>
            <% end %>

            <% if can?(:DILIGENCIA_CREATE) %>
              <div class="sidebar-section">Diligências</div>
              
              <%= link_to admin_diligences_path, class: nav_link_class("diligences", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                </svg>
                <span class="sidebar-link-text">Diligências</span>
              <% end %>
            <% end %>

            <% if can?(:DOCUMENT_VIEW) %>
              <div class="sidebar-section">Documentos</div>
              
              <%= link_to admin_documents_path, class: nav_link_class("documents", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                <span class="sidebar-link-text">Documentos</span>
              <% end %>
            <% end %>

            <% if can?(:MANDADO_VIEW) %>
              <div class="sidebar-section">Mandados</div>
              
              <%= link_to admin_mandates_path, class: nav_link_class("mandates", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="sidebar-link-text">Mandados</span>
              <% end %>
            <% end %>

            <% if can?(:PROCESSO_VIEW) %>
              <div class="sidebar-section">Evidências</div>
              
              <%= link_to admin_evidences_path, class: nav_link_class("evidences", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span class="sidebar-link-text">Evidências</span>
              <% end %>
            <% end %>

            <% if can?(:USER_MANAGE) %>
              <div class="sidebar-section">Administração</div>
              
              <%= link_to admin_organizations_path, class: nav_link_class("organizations", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                <span class="sidebar-link-text">Organizações</span>
              <% end %>

              <%= link_to admin_users_path, class: nav_link_class("users", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                <span class="sidebar-link-text">Utilizadores</span>
              <% end %>
            <% end %>

            <% if can?(:AUDIT_VIEW) %>
              <div class="sidebar-section">Auditoria</div>
              
              <%= link_to admin_audit_path, class: nav_link_class("audit", "index"), data: { turbo: true } do %>
                <svg class="sidebar-link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                </svg>
                <span class="sidebar-link-text">Registo de Auditoria</span>
              <% end %>
            <% end %>
          </nav>

          <!-- Footer -->
          <div class="sidebar-footer">
            <div class="sidebar-user">
              <div class="sidebar-user-avatar">
                <%= current_user&.first_name&.first || current_user&.username&.first || "U" %>
              </div>
              <div class="sidebar-user-info">
                <div class="sidebar-user-name"><%= current_user&.first_name || "Utilizador" %></div>
                <div class="sidebar-user-role"><%= current_profile&.code || "-" %></div>
              </div>
              <%= link_to auth_logout_path, method: :delete, data: { turbo: false }, class: "text-slate-400 hover:text-white transition-colors" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
              <% end %>
            </div>
          </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content flex flex-col h-full overflow-hidden">
          <!-- Topbar -->
          <header class="topbar">
            <div class="flex items-center justify-between">
              <div class="topbar-left flex items-center gap-3">
                <!-- Mobile Menu Button -->
                <button type="button" class="mobile-menu-btn fb-btn-icon lg:hidden" onclick="toggleSidebar()" aria-label="Menu">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </button>
                <h1 class="topbar-title"><%= yield(:page_title) || "Dashboard" %></h1>
              </div>
              <div class="topbar-right">
                <!-- Notifications -->
                <button type="button" class="fb-btn-icon relative" title="Notificações">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                  </svg>
                  <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-white text-xs flex items-center justify-center font-medium">3</span>
                </button>
                
                <!-- Settings -->
                <!-- Dark Mode Toggle -->
                <button type="button" data-controller="dark-mode"
                    data-action="click->dark-mode#toggle"
                    class="fb-btn-icon" title="Alternar tema"
                    aria-label="Alternar tema claro/escuro">
                  <span data-dark-mode-target="toggle">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                  </span>
                </button>
                <%= link_to "#", class: "fb-btn-icon", title: "Definições" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                <% end %>
              </div>
            </div>
          </header>

          <!-- Flash Messages -->
          <% if flash.any? %>
            <div class="bg-white border-b border-slate-200 px-4 py-2 lg:px-6">
              <% flash.each do |type, message| %>
                <div class="<%= flash_class(type) %> flex items-center gap-2">
                  <% if type == 'notice' %>
                    <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  <% elsif type == 'alert' %>
                    <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  <% end %>
                  <span class="text-sm"><%= message %></span>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Page Content -->
          <main class="page-content flex-1 overflow-y-auto">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <!-- Public Layout -->
      <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        <%= yield %>
      </div>
    <% end %>

    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('mobile-overlay');
        
        if (sidebar) {
          sidebar.classList.toggle('mobile-open');
        }
        if (overlay) {
          overlay.classList.toggle('hidden');
        }
        
        localStorage.setItem('sidebar-mobile-open', sidebar?.classList.contains('mobile-open') || false);
      }

      // Close sidebar on escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          const sidebar = document.getElementById('sidebar');
          const overlay = document.getElementById('mobile-overlay');
          if (sidebar && sidebar.classList.contains('mobile-open')) {
            toggleSidebar();
          }
        }
      });
    </script>
  </body>
</html>
