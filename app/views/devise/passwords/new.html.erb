<!-- 
  ============================================================
  SIP — Devise Password Reset
  Professional Flowbite Design System v2.0
  ============================================================
-->

<div class="auth-page">
  <!-- Left Panel — Branding (Desktop) -->
  <div class="hidden lg:flex lg:w-1/2 relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="pwd-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#pwd-grid)"/>
      </svg>
    </div>
    
    <div class="absolute top-0 left-0 w-96 h-96 bg-yellow-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-orange-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 translate-x-1/2 translate-y-1/2"></div>
    
    <div class="relative z-10 flex flex-col justify-between p-16 w-full">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-orange-600 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
        </div>
        <span class="text-white text-xl font-bold tracking-tight">SIP</span>
      </div>
      
      <div class="space-y-6">
        <h1 class="text-4xl font-bold text-white leading-tight">
          Recuperar<br>
          <span class="text-yellow-400">acesso</span>
        </h1>
        <p class="text-slate-400 text-lg max-w-md leading-relaxed">
          Introduz o teu email e receberás um link para redefinir a palavra-passe.
        </p>
      </div>
      
      <div class="flex gap-12">
        <div>
          <div class="text-2xl font-bold text-white">SIC</div>
          <div class="text-sm text-slate-500 mt-1">Segurança Interna</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-white">Angola</div>
          <div class="text-sm text-slate-500 mt-1">República de</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Panel — Reset Form -->
  <div class="w-full lg:w-1/2 flex items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-md">
      
      <!-- Mobile Logo -->
      <div class="lg:hidden flex items-center gap-3 mb-8 justify-center">
        <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-orange-600 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
        </div>
        <div>
          <span class="text-slate-900 text-xl font-bold">SIP</span>
          <span class="block text-xs text-slate-500">SIC Angola</span>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if flash[:alert] %>
        <div class="fb-alert fb-alert-error mb-6 animate-slideDown">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="fb-alert fb-alert-success mb-6 animate-slideDown">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>

      <!-- Header -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900">Recuperar palavra-passe</h2>
        <p class="text-slate-500 mt-1">Vais receber um email com instruções</p>
      </div>

      <!-- Reset Form -->
      <div class="fb-card animate-slideUp">
        <div class="fb-card-body">
          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
            
            <!-- Email Field -->
            <div class="fb-field-group">
              <%= f.label :email, class: "fb-label" %>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <%= f.email_field :email, 
                      autofocus: true, 
                      autocomplete: "email", 
                      placeholder: "o.teu.email@sic.gov.ao", 
                      class: "fb-input ps-10" %>
              </div>
            </div>
            
            <!-- Submit Button -->
            <div>
              <%= f.submit "Enviar instruções", class: "fb-btn fb-btn-primary w-full" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Enviar Link de Recuperação
              <% end %>
            </div>
          <% end %>
        </div>
        
        <!-- Footer Links -->
        <div class="fb-card-footer border-t border-slate-200">
          <div class="flex flex-col gap-2 w-full">
            <%= link_to "Voltar ao login", new_account_session_path(resource_name), class: "fb-btn fb-btn-secondary w-full justify-center" %>
            <%= link_to "Criar uma conta", new_registration_path(resource_name), class: "fb-btn fb-btn-link w-full justify-center text-sm" %>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <p class="mt-8 text-center text-xs text-slate-400">
        © <%= Date.current.year %> SIP — Serviço de Investigação Criminal<br>
        República de Angola
      </p>
    </div>
  </div>
</div>
