<!-- 
  ============================================================
  SISTEMA DE INSTRUÇÃO PROCESSUAL — SIP
  Login Page — Professional Government Portal
  ============================================================
-->

<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIP — Sistema de Instrução Processual | Login</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    /* === PROFESSIONAL GOVERNMENT LOGIN DESIGN === */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');
    
    :root {
      --primary: #1e3a5f;
      --primary-light: #2c4f7c;
      --primary-dark: #0f1f33;
      --accent: #c9a227;
      --accent-light: #d4b23a;
      --success: #059669;
      --error: #dc2626;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1);
      --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
    }
    
    .login-container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    /* === TOP BAR === */
    .top-bar {
      background: var(--primary-dark);
      padding: 0.5rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      color: rgba(255,255,255,0.7);
    }
    
    .top-bar__security {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .top-bar__lang {
      display: flex;
      gap: 1rem;
    }
    
    .top-bar__lang a {
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      transition: color 0.2s;
    }
    
    .top-bar__lang a:hover {
      color: var(--accent);
    }
    
    /* === MAIN LAYOUT === */
    .login-main {
      flex: 1;
      display: flex;
    }
    
    /* === LEFT PANEL — BRANDING === */
    .brand-panel {
      flex: 1;
      background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 50%, var(--primary-light) 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem;
      position: relative;
      overflow: hidden;
    }
    
    .brand-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background: 
        repeating-linear-gradient(
          45deg,
          transparent,
          transparent 35px,
          rgba(255,255,255,0.01) 35px,
          rgba(255,255,255,0.01) 70px
        );
    }
    
    .brand-panel::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--accent) 0%, var(--accent-light) 50%, var(--accent) 100%);
    }
    
    .brand-content {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 400px;
    }
    
    /* Coat of Arms / Logo */
    .coat-of-arms {
      width: 120px;
      height: 120px;
      margin: 0 auto 2rem;
      position: relative;
    }
    
    .coat-of-arms__shield {
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--accent);
      backdrop-filter: blur(10px);
    }
    
    .coat-of-arms__icon {
      width: 60px;
      height: 60px;
      color: var(--accent);
    }
    
    .brand-title {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 700;
      color: white;
      margin-bottom: 0.5rem;
      letter-spacing: 0.02em;
    }
    
    .brand-subtitle {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.8);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 2rem;
    }
    
    .brand-description {
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.7);
      line-height: 1.7;
      margin-bottom: 2rem;
    }
    
    .brand-features {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .brand-feature {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: rgba(255,255,255,0.8);
      font-size: 0.875rem;
    }
    
    .brand-feature__icon {
      width: 20px;
      height: 20px;
      color: var(--accent);
      flex-shrink: 0;
    }
    
    /* === RIGHT PANEL — FORM === */
    .form-panel {
      width: 520px;
      min-width: 520px;
      background: var(--surface);
      display: flex;
      flex-direction: column;
      padding: 0;
      box-shadow: -8px 0 30px rgba(0,0,0,0.1);
    }
    
    /* Form Header */
    .form-header {
      padding: 2.5rem 2.5rem 2rem;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg, #fafbfc 0%, white 100%);
    }
    
    .form-header__mobile-logo {
      display: none;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    
    .form-header__mini-shield {
      width: 40px;
      height: 40px;
      background: var(--primary);
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .form-header__mini-shield svg {
      width: 20px;
      height: 20px;
      color: var(--accent);
    }
    
    .form-header__title {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.25rem;
    }
    
    .form-header__desc {
      font-size: 0.875rem;
      color: var(--text-muted);
    }
    
    /* Form Body */
    .form-body {
      flex: 1;
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    
    /* User Type Selector */
    .user-type-selector {
      display: flex;
      gap: 0.75rem;
      padding: 0.5rem;
      background: var(--bg);
      border-radius: 0.75rem;
      border: 1px solid var(--border);
    }
    
    .user-type-btn {
      flex: 1;
      padding: 0.75rem 1rem;
      border: none;
      background: transparent;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    
    .user-type-btn:hover {
      color: var(--text);
    }
    
    .user-type-btn.active {
      background: white;
      color: var(--primary);
      box-shadow: var(--shadow);
    }
    
    .user-type-btn svg {
      width: 16px;
      height: 16px;
    }
    
    /* Form Group */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .form-label {
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }
    
    .form-label__required {
      color: var(--error);
    }
    
    .input-wrapper {
      position: relative;
    }
    
    .input-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: var(--text-muted);
      pointer-events: none;
      transition: color 0.2s;
    }
    
    .form-input {
      width: 100%;
      padding: 0.875rem 1rem 0.875rem 2.75rem;
      border: 1.5px solid var(--border);
      border-radius: 0.625rem;
      font-size: 0.9375rem;
      font-family: inherit;
      color: var(--text);
      background: white;
      transition: all 0.2s;
    }
    
    .form-input::placeholder {
      color: var(--text-muted);
      opacity: 0.7;
    }
    
    .form-input:hover {
      border-color: #cbd5e1;
    }
    
    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(30,58,95,0.1);
    }
    
    .form-input:focus ~ .input-icon,
    .form-input:focus + .input-icon {
      color: var(--primary);
    }
    
    /* Password Toggle */
    .password-toggle {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      padding: 0.25rem;
      cursor: pointer;
      color: var(--text-muted);
      transition: color 0.2s;
    }
    
    .password-toggle:hover {
      color: var(--text);
    }
    
    /* Remember & Forgot */
    .form-options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.5rem;
    }
    
    .checkbox-wrapper {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }
    
    .checkbox-wrapper input[type="checkbox"] {
      width: 16px;
      height: 16px;
      border: 1.5px solid var(--border);
      border-radius: 0.25rem;
      cursor: pointer;
      accent-color: var(--primary);
    }
    
    .checkbox-wrapper label {
      font-size: 0.8125rem;
      color: var(--text-muted);
      cursor: pointer;
    }
    
    .forgot-link {
      font-size: 0.8125rem;
      color: var(--primary);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    
    .forgot-link:hover {
      color: var(--primary-light);
      text-decoration: underline;
    }
    
    /* Submit Button */
    .submit-btn {
      width: 100%;
      padding: 1rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      border: none;
      border-radius: 0.625rem;
      font-size: 1rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 4px 12px rgba(30,58,95,0.3);
    }
    
    .submit-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(30,58,95,0.4);
    }
    
    .submit-btn:active {
      transform: translateY(0);
    }
    
    .submit-btn svg {
      width: 18px;
      height: 18px;
    }
    
    /* Divider */
    .form-divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: var(--text-muted);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    
    .form-divider::before,
    .form-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    
    /* Alert Messages */
    .alert {
      padding: 1rem;
      border-radius: 0.625rem;
      font-size: 0.875rem;
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }
    
    .alert--error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
    }
    
    .alert--success {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #166534;
    }
    
    .alert--info {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1e40af;
    }
    
    .alert svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      margin-top: 1px;
    }
    
    /* Form Footer */
    .form-footer {
      padding: 1.5rem 2.5rem;
      border-top: 1px solid var(--border);
      background: var(--bg);
    }
    
    .form-footer__info {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .footer-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      color: var(--text-muted);
    }
    
    .footer-item svg {
      width: 14px;
      height: 14px;
      color: var(--success);
    }
    
    /* === BOTTOM BAR === */
    .bottom-bar {
      background: var(--primary-dark);
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      color: rgba(255,255,255,0.6);
    }
    
    .bottom-bar__left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .bottom-bar__cert {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }
    
    .bottom-bar__right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    
    .bottom-bar a {
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      transition: color 0.2s;
    }
    
    .bottom-bar a:hover {
      color: var(--accent);
    }
    
    /* === MOBILE RESPONSIVE === */
    @media (max-width: 1023px) {
      .brand-panel {
        display: none;
      }
      
      .form-panel {
        width: 100%;
        min-width: unset;
        box-shadow: none;
      }
      
      .form-header__mobile-logo {
        display: flex;
      }
      
      .login-container {
        background: var(--surface);
      }
    }
    
    @media (max-width: 480px) {
      .form-body {
        padding: 1.5rem;
      }
      
      .form-header {
        padding: 1.5rem;
      }
      
      .user-type-selector {
        flex-direction: column;
      }
    }
    
    /* === ANIMATIONS === */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .form-body > * {
      animation: fadeInUp 0.4s ease forwards;
    }
    
    .form-body > *:nth-child(1) { animation-delay: 0.1s; }
    .form-body > *:nth-child(2) { animation-delay: 0.15s; }
    .form-body > *:nth-child(3) { animation-delay: 0.2s; }
    .form-body > *:nth-child(4) { animation-delay: 0.25s; }
    .form-body > *:nth-child(5) { animation-delay: 0.3s; }
  </style>
</head>
<body>
  <div class="login-container">
    <!-- TOP BAR -->
    <div class="top-bar">
      <div class="top-bar__security">
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>Connexão segura — Criptografia AES-256</span>
      </div>
      <div class="top-bar__lang">
        <a href="#">PT</a>
        <a href="#">EN</a>
      </div>
    </div>
    
    <!-- MAIN CONTENT -->
    <div class="login-main">
      <!-- LEFT PANEL — BRANDING -->
      <div class="brand-panel">
        <div class="brand-content">
          <!-- Coat of Arms -->
          <div class="coat-of-arms">
            <div class="coat-of-arms__shield">
              <svg class="coat-of-arms__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
          </div>
          
          <h1 class="brand-title">Sistema de<br>Instrução Processual</h1>
          <p class="brand-subtitle">República de Angola</p>
          <p class="brand-description">
            Plataforma integrada para gestão e acompanhamento de processos de instrução criminal do Serviço de Investigação Criminal.
          </p>
          
          <div class="brand-features">
            <div class="brand-feature">
              <svg class="brand-feature__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>Acesso restrito a pessoal autorizado</span>
            </div>
            <div class="brand-feature">
              <svg class="brand-feature__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <span>Dados protegidos conforme legislação angolana</span>
            </div>
            <div class="brand-feature">
              <svg class="brand-feature__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
              <span>Rastreabilidade completa de todas as ações</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- RIGHT PANEL — FORM -->
      <div class="form-panel">
        <div class="form-header">
          <!-- Mobile Logo -->
          <div class="form-header__mobile-logo">
            <div class="form-header__mini-shield">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <div style="font-weight:600;color:var(--text);font-size:1rem;">SIP</div>
              <div style="font-size:0.6875rem;color:var(--text-muted);">Sistema de Instrução Processual</div>
            </div>
          </div>
          
          <h2 class="form-header__title">Iniciar Sessão</h2>
          <p class="form-header__desc">Acesse a plataforma com as suas credenciais institucionais</p>
        </div>
        
        <div class="form-body">
          <!-- Flash Messages -->
          <% if flash[:alert] %>
            <div class="alert alert--error">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span><%= flash[:alert] %></span>
            </div>
          <% end %>
          
          <% if flash[:notice] %>
            <div class="alert alert--success">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span><%= flash[:notice] %></span>
            </div>
          <% end %>
          
          <!-- User Type Selector -->
          <div class="user-type-selector">
            <button type="button" class="user-type-btn active" data-type="operador">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Operador
            </button>
            <button type="button" class="user-type-btn" data-type="administrador">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              Administrador
            </button>
          </div>
          
          <!-- Login Form -->
          <%= form_for(resource, as: resource_name, url: account_session_path(resource_name), html: { class: "space-y-5", data: { turbo: false } }) do |f| %>
            
            <!-- Email Field -->
            <div class="form-group">
              <label class="form-label">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Email institucional <span class="form-label__required">*</span>
              </label>
              <div class="input-wrapper">
                <%= f.email_field :email, 
                      autofocus: true, 
                      autocomplete: "email", 
                      placeholder: "nome@sic.gov.ao", 
                      class: "form-input" %>
                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
            </div>
            
            <!-- Password Field -->
            <div class="form-group">
              <label class="form-label">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                Palavra-passe <span class="form-label__required">*</span>
              </label>
              <div class="input-wrapper">
                <%= f.password_field :password, 
                      autocomplete: "current-password", 
                      placeholder: "••••••••", 
                      class: "form-input",
                      id: "password-field" %>
                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Mostrar/Ocultar palavra-passe">
                  <svg id="eye-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </button>
              </div>
            </div>
            
            <!-- Remember & Forgot -->
            <% if devise_mapping.rememberable? %>
              <div class="form-options">
                <div class="checkbox-wrapper">
                  <%= f.check_box :remember_me %>
                  <%= f.label :remember_me, "Manter sessão" %>
                </div>
                <%= link_to new_password_path(resource_name), class: "forgot-link" do %>
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                  Recuperar acesso
                <% end %>
              </div>
            <% end %>
            
            <!-- Submit Button -->
            <div>
              <%= f.submit "Entrar no Sistema", class: "submit-btn" do %>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
                Autenticar
              <% end %>
            </div>
          <% end %>
        </div>
        
        <!-- Form Footer -->
        <div class="form-footer">
          <div class="form-footer__info">
            <div class="footer-item">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>Sistema certificado conforme Normas ISO 27001</span>
            </div>
            <div class="footer-item">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>Acesso exclusivamente para pessoal da SIC autorizado</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- BOTTOM BAR -->
    <div class="bottom-bar">
      <div class="bottom-bar__left">
        <div class="bottom-bar__cert">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span>SIP v2.0 — República de Angola</span>
        </div>
        <span>© <%= Date.current.year %> SIC Angola</span>
      </div>
      <div class="bottom-bar__right">
        <a href="#">Política de Privacidade</a>
        <a href="#">Termos de Uso</a>
        <a href="#">Suporte Técnico</a>
      </div>
    </div>
  </div>
  
  <script>
    // Password visibility toggle
    function togglePassword() {
      const field = document.getElementById('password-field');
      const icon = document.getElementById('eye-icon');
      if (field.type === 'password') {
        field.type = 'text';
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
      } else {
        field.type = 'password';
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
      }
    }
    
    // User type selector
    document.querySelectorAll('.user-type-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.user-type-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
      });
    });
  </script>
</body>
</html>
