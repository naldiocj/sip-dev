<%- if controller_name != 'sessions' %>
  <%= link_to "Entrar", new_account_session_path(resource_name), class: "fb-btn fb-btn-link w-full justify-center" %>
<% end -%>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to "Criar conta", new_registration_path(resource_name), class: "fb-btn fb-btn-secondary w-full justify-center" %>
<% end -%>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to "Recuperar palavra-passe", new_password_path(resource_name), class: "fb-btn fb-btn-link w-full justify-center" %>
<% end -%>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Não recebeu as instruções de confirmação?", new_confirmation_path(resource_name), class: "fb-btn fb-btn-link w-full justify-center text-sm" %>
<% end -%>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Não recebeu as instruções de desbloqueio?", new_unlock_path(resource_name), class: "fb-btn fb-btn-link w-full justify-center text-sm" %>
<% end -%>
