<!-- 
  ============================================================
  SIP — Devise Registrations (Create Account)
  Professional Flowbite Design System v2.0
  ============================================================
-->

<div class="auth-page">
  <!-- Left Panel — Branding (Desktop) -->
  <div class="hidden lg:flex lg:w-1/2 relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="reg-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#reg-grid)"/>
      </svg>
    </div>
    
    <div class="absolute top-0 left-0 w-96 h-96 bg-green-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 translate-x-1/2 translate-y-1/2"></div>
    
    <div class="relative z-10 flex flex-col justify-between p-16 w-full">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <span class="text-white text-xl font-bold tracking-tight">SIP</span>
      </div>
      
      <div class="space-y-6">
        <h1 class="text-4xl font-bold text-white leading-tight">
          Junta-te à<br>
          <span class="text-green-400">equipa</span>
        </h1>
        <p class="text-slate-400 text-lg max-w-md leading-relaxed">
          Cria a tua conta para aceder à plataforma de gestão de processos criminais.
        </p>
      </div>
      
      <div class="flex gap-12">
        <div>
          <div class="text-2xl font-bold text-white">SIC</div>
          <div class="text-sm text-slate-500 mt-1">Segurança Interna</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-white">Angola</div>
          <div class="text-sm text-slate-500 mt-1">República de</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Panel — Registration Form -->
  <div class="w-full lg:w-1/2 flex items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-md">
      
      <!-- Mobile Logo -->
      <div class="lg:hidden flex items-center gap-3 mb-8 justify-center">
        <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <div>
          <span class="text-slate-900 text-xl font-bold">SIP</span>
          <span class="block text-xs text-slate-500">SIC Angola</span>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if flash[:alert] %>
        <div class="fb-alert fb-alert-error mb-6 animate-slideDown">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <!-- Header -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900">Criar conta</h2>
        <p class="text-slate-500 mt-1">Preenche os dados para te registas</p>
      </div>

      <!-- Registration Form -->
      <div class="fb-card animate-slideUp">
        <div class="fb-card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
            
            <!-- Username Field -->
            <div class="fb-field-group">
              <%= f.label :username, class: "fb-label" %>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <%= f.text_field :username, 
                      autofocus: true, 
                      autocomplete: "username", 
                      placeholder: "O teu nome de utilizador", 
                      class: "fb-input ps-10" %>
              </div>
            </div>

            <!-- Email Field -->
            <div class="fb-field-group">
              <%= f.label :email, class: "fb-label" %>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <%= f.email_field :email, 
                      autocomplete: "email", 
                      placeholder: "o.teu.email@sic.gov.ao", 
                      class: "fb-input ps-10" %>
              </div>
            </div>
            
            <!-- Password Field -->
            <div class="fb-field-group">
              <%= f.label :password, class: "fb-label" %>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </div>
                <%= f.password_field :password, 
                      autocomplete: "new-password", 
                      placeholder: "Mínimo 8 caracteres", 
                      class: "fb-input ps-10" %>
              </div>
              <p class="fb-field-hint mt-1">Deve ter pelo menos 8 caracteres</p>
            </div>
            
            <!-- Password Confirmation -->
            <div class="fb-field-group">
              <%= f.label :password_confirmation, class: "fb-label" %>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <%= f.password_field :password_confirmation, 
                      autocomplete: "new-password", 
                      placeholder: "Repete a palavra-passe", 
                      class: "fb-input ps-10" %>
              </div>
            </div>
            
            <!-- Submit Button -->
            <div>
              <%= f.submit "Criar conta", class: "fb-btn fb-btn-primary w-full" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
                Criar Conta
              <% end %>
            </div>
          <% end %>
        </div>
        
        <!-- Footer Links -->
        <div class="fb-card-footer border-t border-slate-200">
          <p class="text-sm text-slate-600 text-center w-full">
            Já tens conta?
            <%= link_to "Entrar", new_session_path(resource_name), class: "font-semibold text-blue-600 hover:text-blue-700 transition-colors" %>
          </p>
        </div>
      </div>

      <!-- Footer -->
      <p class="mt-8 text-center text-xs text-slate-400">
        © <%= Date.current.year %> SIP — Serviço de Investigação Criminal<br>
        República de Angola
      </p>
    </div>
  </div>
</div>
