<% content_for :page_title, "Mandados" %>

<%= render "shared/breadcrumb" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Mandados</h1>
    <p class="text-sm text-slate-500 mt-1"><%= @mandates.count %> registados</p>
  </div>
  <% if can?(:MANDADO_CREATE) %>
    <%= link_to new_admin_mandate_path, class: "fb-btn fb-btn-primary", data: { turbo_frame: "_top" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Novo Mandado
    <% end %>
  <% end %>
</div>

<!-- Mandates Table -->
<div class="fb-card">
  <div class="fb-card-header">
    <h3 class="fb-card-title">Lista de Mandados</h3>
    <span class="fb-badge fb-badge-blue"><%= @mandates.count %></span>
  </div>
  <div class="overflow-x-auto">
    <table class="fb-table">
      <thead>
        <tr>
          <th>Número</th>
          <th>Tipo</th>
          <th>Processo</th>
          <th>Estado</th>
          <th>Emitido em</th>
          <th class="text-right">Acções</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @mandates.each do |m| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="font-medium text-slate-900"><%= m.number %></td>
            <td><%= m.mandate_type&.name || "—" %></td>
            <td>
              <p class="text-sm text-slate-900"><%= m.process&.number || "—" %></p>
            </td>
            <td><%= estado_badge(m.state) %></td>
            <td><%= m.issued_at&.strftime("%d/%m/%Y") %></td>
            <td class="text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to admin_mandate_path(m), class: "fb-btn-icon text-slate-400 hover:text-blue-600", title: "Ver" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                <% end %>
                <%= link_to edit_admin_mandate_path(m), class: "fb-btn-icon text-slate-400 hover:text-blue-600", title: "Editar", data: { turbo_frame: "_top" } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
