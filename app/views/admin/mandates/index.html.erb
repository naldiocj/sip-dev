<% content_for :page_title, "Mandados" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Mandados</h1>
    <p class="text-sm text-gray-500 mt-1">Gestão de mandados e actos coercivos</p>
  </div>
  <%= link_to new_admin_mandate_path, class: "btn btn-primary", data: { turbo: false } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    Novo Mandado
  <% end %>
</div>

<!-- Overdue Alert -->
<% if @overdue_count.positive? %>
  <div class="alert alert-error mb-6">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <span><%= @overdue_count %> mandado(s) vencido(s)</span>
  </div>
<% end %>

<!-- Filters -->
<div class="fb-card mb-6">
  <div class="fb-card-body p-4">
    <%= form_with url: admin_mandates_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :search, "Pesquisar", class: "label" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Descrição ou destino...", class: "input" %>
      </div>
      <div>
        <%= f.label :estado, "Estado", class: "label" %>
        <%= f.select :estado,
              {"" => "Todos", "emitido" => "Emitido", "em_andamento" => "Em Andamento", "executado" => "Executado", "cancelado" => "Cancelado"},
              { include_hidden: false },
              { class: "select", data: { turbo: false } %>
      </div>
      <div>
        <%= f.label :type, "Tipo", class: "label" %>
        <%= f.select :type,
              {"" => "Todos"} + @mandate_types.map { |t| [t.humanize, t] },
              { include_hidden: false },
              { class: "select", data: { turbo: false } %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "btn btn-primary" %>
        <%= link_to "Limpar", admin_mandates_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Mandates List -->
<div class="fb-card">
  <div class="fb-card-body p-0">
    <% if @mandates.any? %>
      <div class="overflow-x-auto">
        <table class="fb-table">
          <thead>
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Processo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Destino</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Emissor</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Prazo</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acções</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @mandates.each do |m| %>
              <tr class="hover:bg-gray-50 <%= 'bg-red-50' if m.data_prazo.present? && m.data_prazo.past? && m.estado != 'executado' && m.estado != 'cancelado' %>">
                <td class="px-4 py-3">
                  <span class="text-sm font-medium text-gray-900"><%= m.mandate_type %></span>
                </td>
                <td class="px-4 py-3">
                  <% if m.process.present? %>
                    <%= link_to m.process.numero, admin_process_path(m.process), class: "text-sm text-blue-600 hover:text-blue-700", data: { turbo: false } %>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 max-w-xs">
                  <span class="text-sm text-gray-900"><%= truncate(m.destino, length: 30) %></span>
                  <p class="text-xs text-gray-400 mt-1"><%= truncate(m.descricao, length: 50) %></p>
                </td>
                <td class="px-4 py-3">
                  <%= estado_badge(m.estado) %>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-700"><%= m.emissor&.full_name || "—" %></span>
                </td>
                <td class="px-4 py-3">
                  <% if m.data_prazo.present? %>
                    <span class="text-sm <%= m.data_prazo.past? && m.estado != 'executado' && m.estado != 'cancelado' ? 'text-red-600 font-medium' : 'text-gray-600' %>">
                      <%= m.data_prazo.strftime("%d/%m/%Y") %>
                    </span>
                    <% if m.data_prazo.past? && m.estado != 'executado' && m.estado != 'cancelado' %>
                      <span class="text-xs text-red-500 block">Vencido</span>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <%= link_to admin_mandate_path(m), class: "btn btn-sm btn-secondary", data: { turbo: false } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  <% end %>
                  <%= link_to edit_admin_mandate_path(m), class: "btn btn-sm btn-secondary ml-1", data: { turbo: false } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  <% end %>
                  <% if m.estado == 'emitido' || m.estado == 'em_andamento' %>
                    <%= link_to execute_admin_mandate_path(m), method: :post, class: "btn btn-sm btn-success ml-1", data: { turbo: false } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                    <% end %>
                    <%= link_to cancel_admin_mandate_path(m), method: :post, class: "btn btn-sm btn-danger ml-1", data: { turbo: false } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                    <% end ">
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-4 py-3 border-t border-gray-100">
        <%= paginate @mandates %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <p class="mt-2 text-sm text-gray-500">Nenhum mandado encontrado</p>
        <%= link_to new_admin_mandate_path, class: "mt-4 btn btn-primary", data: { turbo: false } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Criar Primeiro Mandado
        <% end %>
      </div>
    <% end %>
  </div>
</div>
