<% content_for :page_title, "Evidências" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Evidências</h1>
    <p class="text-sm text-gray-500 mt-1">Gestão de provas e documentos probatórios</p>
  </div>
  <%= link_to new_admin_evidence_path, class: "fb-btn fb-btn-primary", data: { turbo: false } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    Nova Evidência
  <% end %>
</div>

<!-- Filters -->
<div class="card mb-6">
  <div class="fb-card-body p-4">
    <%= form_with url: admin_evidences_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :search, "Pesquisar", class: "label" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Descrição...", class: "input" %>
      </div>
      <div>
        <%= f.label :type, "Tipo", class: "label" %>
        <%= f.select :type,
              {"" => "Todos"} + @evidence_types.map { |t| [t.humanize, t] },
              { include_hidden: false },
              { class: "select", data: { turbo: false } %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "fb-btn fb-btn-primary" %>
        <%= link_to "Limpar", admin_evidences_path, class: "fb-btn fb-btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Evidences List -->
<div class="fb-card">
  <div class="fb-card-body p-0">
    <% if @evidences.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Processo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Descrição</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Coletor</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data Coleta</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acções</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @evidences.each do |e| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <span class="fb-badge fb-badge-blue"><%= e.evidence_type %></span>
                </td>
                <td class="px-4 py-3">
                  <% if e.process.present? %>
                    <%= link_to e.process.numero, admin_process_path(e.process), class: "text-sm text-blue-600 hover:text-blue-700", data: { turbo: false } %>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 max-w-xs">
                  <span class="text-sm text-gray-900"><%= truncate(e.descricao, length: 40) %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-700"><%= e.collector&.full_name || "—" %></span>
                </td>
                <td class="px-4 py-3">
                  <% if e.collected_at.present? %>
                    <span class="text-sm text-gray-600"><%= e.collected_at.strftime("%d/%m/%Y") %></span>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <%= link_to admin_evidence_path(e), class: "btn btn-sm btn-secondary", data: { turbo: false } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  <% end %>
                  <% if e.file.attached? %>
                    <%= link_to download_admin_evidence_path(e), class: "btn btn-sm btn-primary ml-1", data: { turbo: false } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                      </svg>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-4 py-3 border-t border-gray-100">
        <%= paginate @evidences %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <p class="mt-2 text-sm text-gray-500">Nenhuma evidência encontrada</p>
        <%= link_to new_admin_evidence_path, class: "mt-4 btn btn-primary", data: { turbo: false } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Criar Primeira Evidência
        <% end %>
      </div>
    <% end %>
  </div>
</div>
