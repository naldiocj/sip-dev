<% content_for :page_title, @evidence.evidence_type %>

<nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
  <%= link_to "Evidências", admin_evidences_path, class: "hover:text-gray-900" %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
  </svg>
  <span class="text-gray-900"><%= @evidence.descricao&.truncate(40) || "Evidência" %></span>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="card">
      <div class="card-header flex items-start justify-between">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="badge badge-blue"><%= @evidence.evidence_type %></span>
          </div>
          <h1 class="text-2xl font-bold text-gray-900">Evidência</h1>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to edit_admin_evidence_path(@evidence), class: "btn btn-secondary", data: { turbo: false } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Editar
          <% end %>
          <%= link_to admin_evidences_path, class: "btn btn-secondary", data: { turbo: false } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Voltar
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <p class="text-gray-600"><%= @evidence.descricao %></p>

        <% if @evidence.file.attached? %>
          <div class="mt-6 p-4 bg-gray-50 rounded-lg">
            <div class="flex items-center gap-3">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-900"><%= @evidence.file.filename %></p>
                <p class="text-xs text-gray-500"><%= number_to_human_size(@evidence.file.byte_size) %></p>
              </div>
              <%= link_to download_admin_evidence_path(@evidence), class: "btn btn-primary", data: { turbo: false } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                Descarregar
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="card">
      <div class="card-header">
        <h3 class="font-semibold text-gray-900">Informações</h3>
      </div>
      <div class="card-body space-y-4">
        <div>
          <p class="text-xs text-gray-500 uppercase">Processo</p>
          <% if @evidence.process.present? %>
            <%= link_to @evidence.process.numero, admin_process_path(@evidence.process), class: "text-sm text-blue-600 hover:text-blue-700", data: { turbo: false } %>
          <% else %>
            <p class="text-sm text-gray-400">Não associado</p>
          <% end %>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Coletor</p>
          <p class="text-sm text-gray-900"><%= @evidence.collector&.full_name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Data de Coleta</p>
          <p class="text-sm text-gray-900"><%= @evidence.collected_at&.strftime("%d/%m/%Y às %H:%M") || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Criado em</p>
          <p class="text-sm text-gray-900"><%= @evidence.created_at.strftime("%d/%m/%Y às %H:%M") %></p>
        </div>
      </div>
    </div>
  </div>
</div>
