<% content_for :page_title, "Distribuir Processo" %>

<%= render "shared/breadcrumb" %>

<div class="fb-card max-w-2xl">
  <div class="fb-card-header">
    <h3 class="fb-card-title">Distribuir Processo <%= @process.number %></h3>
  </div>
  <div class="fb-card-body">
    <%= form_with url: distribute_admin_process_path(@process), method: :patch, class: "space-y-5" do |f| %>
      <!-- Assignee Field -->
      <div>
        <%= f.label :assignee_id, class: "fb-label" %>
        <%= f.collection_select :assignee_id, @available_assignees, :id, :full_name, { prompt: "Selecionar responsável..." }, class: "fb-select" %>
        <% @process.errors[:assignee_id].each do |message| %>
          <span class="fb-error"><%= message %></span>
        <% end %>
      </div>
      
      <!-- Profile Field -->
      <div>
        <%= f.label :profile_code, class: "fb-label" %>
        <%= f.select :profile_code, @available_profiles, { prompt: "Selecionar perfil..." }, class: "fb-select" %>
        <% @process.errors[:profile_code].each do |message| %>
          <span class="fb-error"><%= message %></span>
        <% end %>
      </div>
      
      <!-- Form Actions -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200">
        <%= link_to admin_process_path(@process), class: "fb-btn fb-btn-secondary" do %>
          Cancelar
        <% end %>
        <%= f.submit "Distribuir", class: "fb-btn fb-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
