<% content_for :page_title, "Distribuir Processo" %>

<div class="max-w-2xl">
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Processos", admin_processes_path, class: "hover:text-gray-900" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <%= link_to @process.numero, admin_process_path(@process), class: "hover:text-gray-900" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <span class="text-gray-900">Distribuir</span>
  </nav>

  <div class="fb-card">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Distribuir Processo</h3>
      <p class="text-sm text-gray-500 mt-1"><%= @process.numero %>/<%= @process.ano %></p>
    </div>
    <div class="fb-card-body">
      <%= form_with url: distribute_admin_process_path(@process), method: :post, local: true do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :destination_organization_id, "Organização de Destino", class: "label" %>
            <%= f.collection_select :destination_organization_id, @organizations, :id, :full_path, { prompt: "Seleccionar organização..." }, { class: "select", required: true } %>
          </div>

          <div>
            <%= f.label :destination_user_id, "Responsável", class: "label" %>
            <%= f.collection_select :destination_user_id, @users, :id, -> { |u| "#{u.first_name} #{u.last_name}" }, { prompt: "Seleccionar responsável (opcional)" }, { class: "select" } %>
          </div>

          <div>
            <%= f.label :reason, "Motivo", class: "label" %>
            <%= f.text_area :reason, rows: 3, class: "textarea", placeholder: "Indique o motivo da distribuição" %>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 mt-6">
          <%= link_to "Cancelar", admin_process_path(@process), class: "btn btn-secondary" %>
          <%= f.submit "Distribuir", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
