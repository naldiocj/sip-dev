<div class="fb-card">
  <div class="fb-card-header">
    <h3 class="fb-card-title"><%= action_title %></h3>
  </div>
  <div class="fb-card-body">
    <%= form_with(model: [:admin, process], class: "space-y-5") do |f| %>
      <!-- Number Field -->
      <div>
        <%= f.label :number, class: "fb-label" %>
        <%= f.text_field :number, class: "fb-input", placeholder: "Ex: 123/2024/SIC" %>
        <% process.errors[:number].each do |message| %>
          <span class="fb-error"><%= message %></span>
        <% end %>
      </div>
      
      <!-- Description Field -->
      <div>
        <%= f.label :description, class: "fb-label" %>
        <%= f.text_area :description, rows: 3, class: "fb-textarea", placeholder: "Descrição do processo..." %>
        <% process.errors[:description].each do |message| %>
          <span class="fb-error"><%= message %></span>
        <% end %>
      </div>
      
      <!-- Type and Priority Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Type Field -->
        <div>
          <%= f.label :process_type_id, class: "fb-label" %>
          <%= f.collection_select :process_type_id, @process_types, :id, :name, { prompt: "Selecionar tipo..." }, class: "fb-select" %>
          <% process.errors[:process_type_id].each do |message| %>
            <span class="fb-error"><%= message %></span>
          <% end %>
        </div>
        
        <!-- Priority Field -->
        <div>
          <%= f.label :priority, class: "fb-label" %>
          <%= f.select :priority, Sip::Process::PRIORITIES.map { |p| [p.humanize, p] }, { include_blank: true }, class: "fb-select" %>
          <% process.errors[:priority].each do |message| %>
            <span class="fb-error"><%= message %></span>
          <% end %>
        </div>
      </div>
      
      <!-- State Field -->
      <div>
        <%= f.label :state, class: "fb-label" %>
        <%= f.select :state, Sip::Process::STATES.map { |s| [s.humanize, s] }, { include_blank: true }, class: "fb-select" %>
        <% process.errors[:state].each do |message| %>
          <span class="fb-error"><%= message %></span>
        <% end %>
      </div>
      
      <!-- Form Actions -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200">
        <%= link_to admin_processes_path, class: "fb-btn fb-btn-secondary" do %>
          Cancelar
        <% end %>
        <%= f.submit action_title, class: "fb-btn fb-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
