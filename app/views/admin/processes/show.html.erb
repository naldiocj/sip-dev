<% content_for :page_title, @process.titulo %>

<!-- Breadcrumb -->
<nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
  <%= link_to "Processos", admin_processes_path, class: "hover:text-gray-900" %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
  </svg>
  <span class="font-mono text-gray-900"><%= @process.numero %></span>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
  </svg>
  <span class="text-gray-900"><%= truncate(@process.titulo, length: 30) %></span>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main Content -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Process Info -->
    <div class="fb-card">
      <div class="fb-card-header flex items-start justify-between">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="font-mono text-sm text-gray-500"><%= @process.numero %>/<%= @process.ano %></span>
            <%= state_badge(@process.state_code) %>
            <%= priority_badge(@process.process_priority&.code) %>
          </div>
          <h1 class="text-2xl font-bold text-gray-900"><%= @process.titulo %></h1>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to edit_admin_process_path(@process), class: "btn btn-secondary", data: { turbo: false } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Editar
          <% end %>
          <% if can?(:PROCESSO_DISTRIBUIR, @process) %>
            <%= link_to distribute_admin_process_path(@process), class: "btn btn-primary", data: { turbo: false } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Distribuir
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="fb-card-body">
        <% if @process.resumo.present? %>
          <p class="text-gray-600"><%= @process.resumo %></p>
        <% else %>
          <p class="text-gray-400 italic">Sem resumo</p>
        <% end %>
      </div>
    </div>

    <!-- Timeline -->
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="font-semibold text-gray-900">Trâmite</h3>
      </div>
      <div class="fb-card-body p-0">
        <% if @transitions.any? %>
          <div class="divide-y divide-gray-100">
            <% @transitions.each do |t| %>
              <div class="px-4 py-3 flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900"><%= t.action_code %></p>
                  <p class="text-xs text-gray-500">
                    <%= t.from_state&.code %> → <%= t.to_state&.code %>
                  </p>
                  <p class="text-xs text-gray-400 mt-1">
                    por <%= t.performed_by&.first_name || "Sistema" %> · <%= time_ago_in_words(t.created_at) %> atrás
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-400">
            <p>Nenhuma movimentação registada</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Audit Events -->
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="font-semibold text-gray-900">Registo de Auditoria</h3>
      </div>
      <div class="fb-card-body p-0">
        <% if @audit_events.any? %>
          <div class="divide-y divide-gray-100">
            <% @audit_events.each do |event| %>
              <div class="px-4 py-3 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900"><%= event.action %></p>
                  <p class="text-xs text-gray-500">
                    <%= event.actor&.first_name || "Sistema" %> · <%= event.created_at.strftime("%d/%m/%Y %H:%M") %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-400">
            <p>Nenhum evento de auditoria</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <!-- Status Card -->
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="font-semibold text-gray-900">Informações</h3>
      </div>
      <div class="fb-card-body space-y-4">
        <div>
          <p class="text-xs text-gray-500 uppercase">Estado Actual</p>
          <p class="text-sm font-medium text-gray-900 mt-1"><%= @process.state_name || @process.process_state&.name %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Tipo de Processo</p>
          <p class="text-sm text-gray-900"><%= @process.process_type&.name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Natureza</p>
          <p class="text-sm text-gray-900"><%= @process.process_nature&.name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Origem</p>
          <p class="text-sm text-gray-900"><%= @process.process_origin&.name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Prioridade</p>
          <p class="text-sm text-gray-900"><%= @process.process_priority&.name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Sigilo</p>
          <p class="text-sm text-gray-900"><%= @process.confidentiality_level&.name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Organização</p>
          <p class="text-sm text-gray-900"><%= @process.organizacao&.name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Responsável</p>
          <p class="text-sm text-gray-900"><%= @process.responsavel&.full_name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Criado por</p>
          <p class="text-sm text-gray-900"><%= @process.created_by&.first_name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Data de Entrada</p>
          <p class="text-sm text-gray-900"><%= @process.data_entrada.strftime("%d/%m/%Y") %></p>
        </div>
      </div>
    </div>

    <!-- Deadlines -->
    <% if @deadlines.any? %>
      <div class="fb-card">
        <div class="fb-card-header flex items-center justify-between">
          <h3 class="font-semibold text-gray-900">Prazos</h3>
          <span class="fb-badge fb-badge fb-badge-red"><%= @deadlines.count %> activos</span>
        </div>
        <div class="fb-card-body space-y-3">
          <% @deadlines.each do |deadline| %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900"><%= deadline.deadline_type %></p>
                <p class="text-xs text-gray-500">até <%= deadline.due_at.strftime("%d/%m/%Y") %></p>
              </div>
              <% if deadline.is_overdue? %>
                <span class="fb-badge fb-badge fb-badge-red">Vencido</span>
              <% elsif deadline.days_until_deadline&.positive? && deadline.days_until_deadline <= 3 %>
                <span class="fb-badge fb-badge fb-badge-yellow"><%= deadline.days_until_deadline %> dias</span>
              <% else %>
                <span class="fb-badge fb-badge fb-badge-green"><%= deadline.days_until_deadline %> dias</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="font-semibold text-gray-900">Acções</h3>
      </div>
      <div class="fb-card-body space-y-2">
        <%= link_to edit_admin_process_path(@process), class: "btn btn-secondary w-full", data: { turbo: false } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Editar Processo
        <% end %>
        <% if can?(:PROCESSO_CREATE) %>
          <%= link_to new_admin_process_path, class: "btn btn-primary w-full", data: { turbo: false } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Novo Processo
          <% end %>
        <% end %>
        <% if can?(:PROCESSO_DISTRIBUIR, @process) %>
          <%= link_to distribute_admin_process_path(@process), class: "btn btn-blue w-full", data: { turbo: false } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Distribuir
          <% end %>
        <% end %>
        <%= link_to admin_processes_path, class: "btn btn-secondary w-full", data: { turbo: false } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Voltar à Lista
        <% end %>
      </div>
    </div>
  </div>
</div>
