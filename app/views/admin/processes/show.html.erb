<% content_for :page_title, "Processo #{@process.number}" %>

<%= render "shared/breadcrumb" %>

<div class="space-y-6">
  <!-- Header Card -->
  <div class="fb-card">
    <div class="fb-card-header flex-col items-start gap-4">
      <div>
        <h1 class="text-xl font-bold text-slate-900"><%= @process.number %></h1>
        <p class="text-sm text-slate-500 mt-1"><%= @process.description || "Sem descrição" %></p>
      </div>
      <div class="flex gap-2">
        <% if can?(:PROCESSO_EDIT) %>
          <%= link_to edit_admin_process_path(@process), class: "fb-btn fb-btn-secondary" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Editar
          <% end %>
        <% end %>
        <%= link_to admin_processes_path, class: "fb-btn fb-btn-secondary" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Voltar
        <% end %>
      </div>
    </div>
    <div class="fb-card-body grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="text-sm text-slate-500 mb-1">Estado</p>
        <div class="flex items-center gap-2">
          <%= estado_badge(@process.state) %>
        </div>
      </div>
      <div>
        <p class="text-sm text-slate-500 mb-1">Prioridade</p>
        <div class="flex items-center gap-2">
          <%= priority_badge(@process.priority) %>
        </div>
      </div>
      <div>
        <p class="text-sm text-slate-500 mb-1">Tipo</p>
        <p class="text-sm font-medium text-slate-900"><%= @process.process_type&.name || "—" %></p>
      </div>
    </div>
  </div>

  <!-- Details Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Information Card -->
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="fb-card-title">Informações do Processo</h3>
      </div>
      <div class="fb-card-body space-y-4">
        <div class="flex justify-between">
          <span class="text-sm text-slate-500">Data de Registo</span>
          <span class="text-sm font-medium text-slate-900"><%= @process.created_at&.strftime("%d/%m/%Y %H:%M") %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-slate-500">Última Atualização</span>
          <span class="text-sm font-medium text-slate-900"><%= @process.updated_at&.strftime("%d/%m/%Y %H:%M") %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-slate-500">Responsável</span>
          <span class="text-sm font-medium text-slate-900"><%= @process.assignee_name || "—" %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-slate-500">Perfil</span>
          <span class="text-sm font-medium text-slate-900"><%= @process.assigned_profile_code || "—" %></span>
        </div>
      </div>
    </div>

    <!-- Related Items Card -->
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="fb-card-title">Itens Relacionados</h3>
      </div>
      <div class="fb-card-body">
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
            <span class="text-sm font-medium text-slate-700">Diligências</span>
            <span class="fb-badge fb-badge-blue"><%= @process.diligences.count %></span>
          </div>
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
            <span class="text-sm font-medium text-slate-700">Documentos</span>
            <span class="fb-badge fb-badge-green"><%= @process.documents.count %></span>
          </div>
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
            <span class="text-sm font-medium text-slate-700">Mandados</span>
            <span class="fb-badge fb-badge-purple"><%= @process.mandates.count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Diligences Section -->
  <% if @process.diligences.any? %>
    <div class="fb-card">
      <div class="fb-card-header">
        <h3 class="fb-card-title">Diligências</h3>
        <% if can?(:DILIGENCIA_CREATE) %>
          <%= link_to new_admin_diligence_path(process_id: @process.id), class: "fb-btn fb-btn-primary", data: { turbo_frame: "_top" } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nova Diligência
          <% end %>
        <% end %>
      </div>
      <div class="overflow-x-auto">
        <table class="fb-table">
          <thead>
            <tr>
              <th>Número</th>
              <th>Tipo</th>
              <th>Estado</th>
              <th>Data</th>
              <th class="text-right">Acções</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @process.diligences.each do |d| %>
              <tr class="hover:bg-slate-50">
                <td class="font-medium text-slate-900"><%= d.number %></td>
                <td><%= d.diligencia_type&.name || "—" %></td>
                <td><%= estado_badge(d.state) %></td>
                <td><%= d.date&.strftime("%d/%m/%Y") %></td>
                <td class="text-right">
                  <%= link_to admin_diligence_path(d), class: "fb-btn-icon text-slate-400 hover:text-blue-600" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
