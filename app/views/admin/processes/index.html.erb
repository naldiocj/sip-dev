<% content_for :page_title, "Processos" %>

<%= render "shared/breadcrumb" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Processos</h1>
    <p class="text-sm text-slate-500 mt-1"><%= @processes.count %> registados</p>
  </div>
  <% if can?(:PROCESSO_CREATE) %>
    <%= link_to new_admin_process_path, class: "fb-btn fb-btn-primary", data: { turbo_frame: "_top" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Novo Processo
    <% end %>
  <% end %>
</div>

<!-- Filters -->
<div class="fb-card mb-6">
  <div class="fb-card-body">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="fb-label">Pesquisar</label>
        <input type="text" id="search-process" placeholder="Número, termo..." class="fb-input" onkeyup="filterProcesses()">
      </div>
      <div>
        <label class="fb-label">Estado</label>
        <select id="filter-state" class="fb-select" onchange="filterProcesses()">
          <option value="">Todos</option>
          <option value="REGISTADO">Registado</option>
          <option value="EM_DISTRIBUICAO">Em Distribuição</option>
          <option value="DISTRIBUIDO">Distribuído</option>
          <option value="CONCLUIDO">Concluído</option>
          <option value="ENCERRADO">Encerrado</option>
        </select>
      </div>
      <div>
        <label class="fb-label">Prioridade</label>
        <select id="filter-priority" class="fb-select" onchange="filterProcesses()">
          <option value="">Todas</option>
          <option value="NORMAL">Normal</option>
          <option value="ALTA">Alta</option>
          <option value="URGENTE">Urgente</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="button" onclick="clearFilters()" class="fb-btn fb-btn-secondary w-full">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          Limpar Filtros
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Processes Table -->
<div class="fb-card">
  <div class="fb-card-header">
    <h3 class="fb-card-title">Lista de Processos</h3>
    <span class="fb-badge fb-badge-blue"><%= @processes.count %></span>
  </div>
  <div class="overflow-x-auto">
    <table class="fb-table">
      <thead>
        <tr>
          <th>Número</th>
          <th>Tipo</th>
          <th>Estado</th>
          <th>Prioridade</th>
          <th>Responsável</th>
          <th>Data Registo</th>
          <th class="text-right">Acções</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @processes.each do |process| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td>
              <p class="font-medium text-slate-900"><%= process.number %></p>
              <p class="text-xs text-slate-500"><%= process.description&.truncate(30) %></p>
            </td>
            <td>
              <span class="text-sm text-slate-600"><%= process.process_type&.name || "—" %></span>
            </td>
            <td>
              <%= estado_badge(process.state) %>
            </td>
            <td>
              <%= priority_badge(process.priority) %>
            </td>
            <td>
              <p class="text-sm text-slate-900"><%= process.assignee_name || "—" %></p>
              <p class="text-xs text-slate-500"><%= process.assigned_profile_code || "—" %></p>
            </td>
            <td>
              <p class="text-sm text-slate-500"><%= process.created_at&.strftime("%d/%m/%Y") %></p>
            </td>
            <td class="text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to admin_process_path(process), class: "fb-btn-icon text-slate-400 hover:text-blue-600", title: "Ver" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                <% end %>
                <% if can?(:PROCESSO_EDIT) %>
                  <%= link_to edit_admin_process_path(process), class: "fb-btn-icon text-slate-400 hover:text-blue-600", title: "Editar", data: { turbo_frame: "_top" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  <% end %>
                <% end %>
                <%= link_to admin_process_path(process), method: :delete, data: { turbo_confirm: "Tem certeza que deseja eliminar este processo?" }, class: "fb-btn-icon text-slate-400 hover:text-red-600", title: "Eliminar" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @processes.any? %>
    <div class="fb-card-footer justify-between items-center">
      <p class="text-sm text-slate-500">Mostrando <%= [@processes.offset_value + 1, @processes.count].min %> de <%= @processes.total_count %> registos</p>
      <div class="flex gap-2">
        <% if @processes.prev_page %>
          <%= link_to "Anterior", admin_processes_path(page: @processes.prev_page), class: "fb-btn fb-btn-secondary" %>
        <% end %>
        <% if @processes.next_page %>
          <%= link_to "Próximo", admin_processes_path(page: @processes.next_page), class: "fb-btn fb-btn-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  function filterProcesses() {
    const search = document.getElementById('search-process').value.toLowerCase();
    const state = document.getElementById('filter-state').value;
    const priority = document.getElementById('filter-priority').value;
    
    // In a real app, this would trigger a Turbo frame reload or fetch request
    console.log('Filter:', { search, state, priority });
  }
  
  function clearFilters() {
    document.getElementById('search-process').value = '';
    document.getElementById('filter-state').value = '';
    document.getElementById('filter-priority').value = '';
    filterProcesses();
  }
</script>
