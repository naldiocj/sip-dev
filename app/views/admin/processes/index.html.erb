<% content_for :page_title, "Processos" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Processos</h1>
    <p class="text-sm text-gray-500 mt-1">Gestão de processos criminais</p>
  </div>
  <%= link_to new_admin_process_path, class: "btn btn-primary", data: { turbo: false } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    Novo Processo
  <% end %>
</div>

<!-- Filters -->
<div class="fb-card mb-6">
  <div class="fb-card-body p-4">
    <%= form_with url: admin_processes_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :search, "Pesquisar", class: "label" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Número ou título...", class: "input" %>
      </div>
      <div>
        <%= f.label :state, "Estado", class: "label" %>
        <%= f.select :state, 
              ProcessState.where(active: true).pluck(:name, :code).insert(0, "Todos os estados", ""),
              { include_hidden: false },
              { class: "select", data: { turbo: false } %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "btn btn-primary" %>
        <%= link_to "Limpar", admin_processes_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Process List -->
<div class="fb-card">
  <div class="fb-card-body p-0">
    <% if @processes.any? %>
      <div class="overflow-x-auto">
        <table class="fb-table">
          <thead>
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nº Processo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Organização</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Responsável</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data Entrada</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acções</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @processes.each do |process| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <span class="font-mono text-sm text-gray-900"><%= process.numero %></span>
                  <span class="text-xs text-gray-400 block"><%= process.ano %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm font-medium text-gray-900"><%= truncate(process.titulo, length: 40) %></span>
                </td>
                <td class="px-4 py-3">
                  <%= state_badge(process.state_code) %>
                </td>
                <td class="px-4 py-3">
                  <% if process.organizacao.present? %>
                    <span class="text-sm text-gray-700"><%= process.organizacao.code %></span>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <% if process.responsavel.present? %>
                    <span class="text-sm text-gray-700"><%= process.responsavel.first_name %> <%= process.responsavel.last_name %></span>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-600"><%= process.data_entrada.strftime("%d/%m/%Y") %></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <%= link_to admin_process_path(process), class: "btn btn-sm btn-secondary", data: { turbo: false } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  <% end %>
                  <% if can?(:PROCESSO_DISTRIBUIR, process) %>
                    <%= link_to distribute_admin_process_path(process), method: :get, class: "btn btn-sm btn-primary ml-1", data: { turbo: false } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                      </svg>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-4 py-3 border-t border-gray-100">
        <%= paginate @processes %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <p class="mt-2 text-sm text-gray-500">Nenhum processo encontrado</p>
        <% if can?(:PROCESSO_CREATE) %>
          <%= link_to new_admin_process_path, class: "mt-4 btn btn-primary", data: { turbo: false } do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Criar Primeiro Processo
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
