<%= form_with(model: [:admin, @process], local: true) do |f| %>
  <% if @process.errors.any? %>
    <div class="alert alert-error mb-6">
      <h3 class="font-semibold">Existem <%= @process.errors.count %> erros:</h3>
      <ul class="list-disc list-inside mt-2">
        <% @process.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="fb-card mb-6">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Informações Básicas</h3>
    </div>
    <div class="fb-card-body space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :numero, "Número do Processo", class: "label" %>
          <%= f.text_field :numero, class: "input", required: true %>
        </div>
        <div>
          <%= f.label :ano, "Ano", class: "label" %>
          <%= f.number_field :ano, value: Time.current.year, class: "input", required: true %>
        </div>
      </div>

      <div>
        <%= f.label :titulo, "Título", class: "label" %>
        <%= f.text_field :titulo, class: "input", required: true, placeholder: "Descrição breve do processo" %>
      </div>

      <div>
        <%= f.label :resumo, "Resumo", class: "label" %>
        <%= f.text_area :resumo, rows: 3, class: "textarea", placeholder: "Descrição detalhada do processo" %>
      </div>

      <div>
        <%= f.label :data_entrada, "Data de Entrada", class: "label" %>
        <%= f.datetime_local_field :data_entrada, value: @process.data_entrada.presence || Time.current, class: "input" %>
      </div>
    </div>
  </div>

  <div class="fb-card mb-6">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Classificação</h3>
    </div>
    <div class="fb-card-body space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :process_type_id, "Tipo de Processo", class: "label" %>
          <%= f.collection_select :process_type_id, @process_types, :id, :name, { prompt: "Seleccionar..." }, { class: "select" } %>
        </div>
        <div>
          <%= f.label :process_nature_id, "Natureza", class: "label" %>
          <%= f.collection_select :process_nature_id, @process_natures, :id, :name, { prompt: "Seleccionar..." }, { class: "select" } %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :process_origin_id, "Origem", class: "label" %>
          <%= f.collection_select :process_origin_id, @process_origins, :id, :name, { prompt: "Seleccionar..." }, { class: "select" } %>
        </div>
        <div>
          <%= f.label :process_priority_id, "Prioridade", class: "label" %>
          <%= f.collection_select :process_priority_id, @process_priorities, :id, :name, { prompt: "Seleccionar..." }, { class: "select" } %>
        </div>
      </div>

      <div>
        <%= f.label :confidentiality_level_id, "Nível de Sigilo", class: "label" %>
        <%= f.collection_select :confidentiality_level_id, @confidentiality_levels, :id, :name, { prompt: "Seleccionar..." }, { class: "select" } %>
      </div>
    </div>
  </div>

  <div class="fb-card mb-6">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Atribuição</h3>
    </div>
    <div class="fb-card-body space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :organizacao_id, "Organização", class: "label" %>
          <%= f.collection_select :organizacao_id, @organizations, :id, :full_path, { prompt: "Seleccionar..." }, { class: "select" } %>
        </div>
        <div>
          <%= f.label :responsavel_id, "Responsável", class: "label" %>
          <%= f.collection_select :responsavel_id, @users, :id, -> { |u| "#{u.first_name} #{u.last_name}" }, { prompt: "Seleccionar..." }, { class: "select" } %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", admin_processes_path, class: "btn btn-secondary" %>
    <%= f.submit @process.new_record? ? "Criar Processo" : "Guardar Alterações", class: "btn btn-primary" %>
  </div>
<% end %>
