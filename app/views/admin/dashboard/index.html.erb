<% content_for :page_title, "Dashboard" %>

<div class="space-y-6">
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="fb-stat-card">
      <div class="flex items-center justify-between">
        <div>
          <p class="fb-stat-label">Processos Totais</p>
          <p class="fb-stat-value"><%= @process_count %></p>
        </div>
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="fb-stat-card">
      <div class="flex items-center justify-between">
        <div>
          <p class="fb-stat-label">Pendentes</p>
          <p class="fb-stat-value text-yellow-600"><%= @pending_count %></p>
        </div>
        <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="fb-stat-card">
      <div class="flex items-center justify-between">
        <div>
          <p class="fb-stat-label">Diligências Ativas</p>
          <p class="fb-stat-value text-purple-600"><%= @diligence_count %></p>
        </div>
        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="fb-stat-card">
      <div class="flex items-center justify-between">
        <div>
          <p class="fb-stat-label">Mandados</p>
          <p class="fb-stat-value text-green-600"><%= @mandate_count %></p>
        </div>
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="fb-card">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Ações Rápidas</h3>
    </div>
    <div class="fb-card-body">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% if can? :PROCESSO_CREATE %>
          <%= link_to new_admin_process_path, class: "btn btn-primary w-full" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Novo Processo
          <% end %>
        <% end %>
        
        <% if can? :DILIGENCIA_CREATE %>
          <%= link_to new_admin_diligence_path, class: "btn btn-secondary w-full" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Nova Diligência
          <% end %>
        <% end %>
        
        <% if can? :USER_MANAGE %>
          <%= link_to admin_users_path, class: "btn btn-secondary w-full" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            Utilizadores
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="fb-card">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Actividade Recente</h3>
    </div>
    <div class="fb-card-body">
      <p class="text-gray-500 text-sm">Sistema pronto para uso. Configure os primeiros utilizadores e organizações.</p>
    </div>
  </div>
</div>
