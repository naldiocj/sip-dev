<% content_for :page_title, "Registo de Auditoria" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Registo de Auditoria</h1>
    <p class="text-sm text-gray-500 mt-1">Histórico completo de todas as acções no sistema</p>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
  <div class="card">
    <div class="card-body">
      <p class="text-sm text-gray-500">Total de Eventos</p>
      <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:total] %></p>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <p class="text-sm text-gray-500">Eventos Hoje</p>
      <p class="text-3xl font-bold text-blue-600 mt-1"><%= @stats[:today] %></p>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <p class="text-sm text-gray-500">Processos Activos</p>
      <p class="text-3xl font-bold text-green-600 mt-1"><%= @stats[:processes] %></p>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="card mb-6">
  <div class="card-body p-4">
    <%= form_with url: admin_audit_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :search, "Pesquisar", class: "label" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Acção ou tipo...", class: "input" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "btn btn-primary" %>
        <%= link_to "Limpar", admin_audit_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Audit Events -->
<div class="card">
  <div class="card-body p-0">
    <% if @events.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Timestamp</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Acção</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Entidade</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Processo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actor</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @events.each do |event| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <span class="text-xs text-gray-500"><%= event.created_at.strftime("%d/%m/%Y %H:%M:%S") %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="badge badge-<%= event.action.include?('CRIADO') ? 'green' : event.action.include?('DISTRIBUIDO') ? 'blue' : event.action.include?('ENCERRADO') ? 'gray' : 'yellow' %>">
                    <%= event.action %>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-700"><%= event.entity_type || "-" %></span>
                </td>
                <td class="px-4 py-3">
                  <% if event.process.present? %>
                    <%= link_to event.process.numero, admin_process_path(event.process), class: "text-sm text-blue-600 hover:text-blue-700", data: { turbo: false } %>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-700"><%= event.actor&.full_name || "Sistema" %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-4 py-3 border-t border-gray-100">
        <%= paginate @events %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
        </svg>
        <p class="mt-2 text-sm text-gray-500">Nenhum evento de auditoria encontrado</p>
      </div>
    <% end %>
  </div>
</div>
