<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Relatório de Evidências</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 10px; }
    h1 { font-size: 18px; text-align: center; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
    th { background-color: #f3f4f6; font-weight: bold; }
    .footer { margin-top: 30px; font-size: 8px; text-align: center; color: #666; }
  </style>
</head>
<body>
  <h1>Relatório de Evidências - SIC Angola</h1>
  <p>Gerado em: <%= Time.current.strftime("%d/%m/%Y às %H:%M") %></p>
  <p>Total: <%= @evidences.count %> evidências</p>

  <table>
    <thead>
      <tr>
        <th>Tipo</th>
        <th>Descrição</th>
        <th>Processo</th>
        <th>Coletor</th>
        <th>Data Coleta</th>
      </tr>
    </thead>
    <tbody>
      <% @evidences.each do |e| %>
        <tr>
          <td><%= e.evidence_type %></td>
          <td><%= e.descricao %></td>
          <td><%= e.process&.numero || "-" %></td>
          <td><%= e.collector&.full_name || "-" %></td>
          <td><%= e.collected_at&.strftime("%d/%m/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="footer">
    <p>SIP - Sistema de Ivory e Processos | Serviço de Investigação Criminal</p>
  </div>
</body>
</html>
