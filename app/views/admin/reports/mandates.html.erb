<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Relatório de Mandados</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 10px; }
    h1 { font-size: 18px; text-align: center; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
    th { background-color: #f3f4f6; font-weight: bold; }
    .footer { margin-top: 30px; font-size: 8px; text-align: center; color: #666; }
  </style>
</head>
<body>
  <h1>Relatório de Mandados - SIC Angola</h1>
  <p>Gerado em: <%= Time.current.strftime("%d/%m/%Y às %H:%M") %></p>
  <p>Total: <%= @mandates.count %> mandados</p>

  <table>
    <thead>
      <tr>
        <th>Tipo</th>
        <th>Destino</th>
        <th>Descrição</th>
        <th>Estado</th>
        <th>Emissor</th>
        <th>Data Emissão</th>
        <th>Data Prazo</th>
      </tr>
    </thead>
    <tbody>
      <% @mandates.each do |m| %>
        <tr>
          <td><%= m.mandate_type %></td>
          <td><%= m.destino %></td>
          <td><%= m.descricao %></td>
          <td><%= m.estado %></td>
          <td><%= m.emissor&.full_name || "-" %></td>
          <td><%= m.data_emissao&.strftime("%d/%m/%Y") %></td>
          <td><%= m.data_prazo&.strftime("%d/%m/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="footer">
    <p>SIP - Sistema de Ivory e Processos | Serviço de Investigação Criminal</p>
  </div>
</body>
</html>
