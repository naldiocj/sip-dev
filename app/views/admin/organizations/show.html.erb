<% content_for :page_title, @organization.name %>

<div class="max-w-4xl">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Organizações", admin_organizations_path, class: "hover:text-gray-900" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <span class="text-gray-900"><%= @organization.code %></span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Info -->
    <div class="lg:col-span-2 space-y-6">
      <div class="fb-card">
        <div class="fb-card-header flex items-start justify-between">
          <div>
            <div class="flex items-center gap-3">
              <span class="fb-badge fb-badge fb-badge-blue"><%= @organization.code %></span>
              <span class="fb-badge fb-badge-<%= case @organization.level
                when 'root' then 'purple'
                when 'direccao_geral' then 'blue'
                when 'direccao' then 'green'
                when 'departamento' then 'yellow'
                when 'seccao' then 'gray'
                when 'piquete' then 'red'
                else 'gray'
              end %>"><%= @organization.level.humanize %></span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mt-2"><%= @organization.name %></h1>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to edit_admin_organization_path(@organization), class: "fb-btn fb-btn-secondary", data: { turbo_frame: "_top" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Editar
            <% end %>
            <% if can?(:destroy, @organization) && @organization.children.empty? %>
              <%= link_to admin_organization_path(@organization), method: :delete, data: { turbo_confirm: "Tem certeza que deseja eliminar #{@organization.name}?" }, class: "btn btn-danger" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                Eliminar
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="fb-card-body">
          <% if @organization.description.present? %>
            <p class="text-gray-600"><%= @organization.description %></p>
          <% else %>
            <p class="text-gray-400 italic">Sem descrição</p>
          <% end %>
        </div>
      </div>

      <!-- Children -->
      <% if @organization.children.any? %>
        <div class="fb-card">
          <div class="fb-card-header">
            <h3 class="font-semibold text-gray-900">Unidades Filhas (<%= @organization.children.count %>)</h3>
          </div>
          <div class="fb-card-body p-0">
            <div class="divide-y divide-gray-100">
              <% @organization.children.order(:level, :code).each do |child| %>
                <div class="px-4 py-3 flex items-center gap-3 hover:bg-gray-50">
                  <span class="text-lg"><%= case child.level
                    when 'direccao' then '📁'
                    when 'departamento' then '📂'
                    when 'seccao' then '📄'
                    when 'piquete' then '🚔'
                    else '•'
                  end %></span>
                  <%= link_to child.name, admin_organization_path(child), class: "flex-1 text-sm font-medium text-gray-900 hover:text-blue-600" %>
                  <span class="fb-badge fb-badge fb-badge-gray text-xs"><%= child.code %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4">
        <div class="fb-stat-card">
          <p class="fb-stat-label">Nível</p>
          <p class="fb-stat-value text-lg"><%= @organization.level.humanize %></p>
        </div>
        <div class="fb-stat-card">
          <p class="fb-stat-label">Filhos</p>
          <p class="fb-stat-value"><%= @organization.children.count %></p>
        </div>
        <div class="fb-stat-card">
          <p class="fb-stat-label">Criado em</p>
          <p class="fb-stat-value text-lg"><%= @organization.created_at.strftime("%d/%m/%Y") %></p>
        </div>
      </div>
    </div>

    <!-- Sidebar Info -->
    <div class="space-y-6">
      <div class="fb-card">
        <div class="fb-card-header">
          <h3 class="font-semibold text-gray-900">Informações</h3>
        </div>
        <div class="fb-card-body space-y-3">
          <div>
            <p class="text-xs text-gray-500 uppercase">Código</p>
            <p class="text-sm font-medium text-gray-900"><%= @organization.code %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase">Nível Hierárquico</p>
            <p class="text-sm font-medium text-gray-900"><%= @organization.level.humanize %></p>
          </div>
          <% if @organization.parent.present? %>
            <div>
              <p class="text-xs text-gray-500 uppercase">Organização Pai</p>
              <%= link_to @organization.parent.name, admin_organization_path(@organization.parent), class: "text-sm text-blue-600 hover:text-blue-700" %>
            </div>
          <% else %>
            <div>
              <p class="text-xs text-gray-500 uppercase">Organização Pai</p>
              <p class="text-sm text-gray-500">Nenhuma (Raiz)</p>
            </div>
          <% end %>
          <div>
            <p class="text-xs text-gray-500 uppercase">Criado em</p>
            <p class="text-sm text-gray-900"><%= @organization.created_at.strftime("%d/%m/%Y às %H:%M") %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase">Actualizado em</p>
            <p class="text-sm text-gray-900"><%= @organization.updated_at.strftime("%d/%m/%Y às %H:%M") %></p>
          </div>
        </div>
      </div>

      <% if can?(:create, Organization) %>
        <div class="fb-card">
          <div class="fb-card-header">
            <h3 class="font-semibold text-gray-900">Adicionar Filho</h3>
          </div>
          <div class="fb-card-body">
            <%= link_to new_admin_organization_path(parent_id: @organization.id), class: "btn btn-primary w-full", data: { turbo_frame: "_top" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Nova Organização
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
