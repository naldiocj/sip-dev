<%= form_with model: [:admin, @organization], class: "space-y-4" do |f| %>
  <% if @organization.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside">
        <% @organization.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :code, class: "form-label" %>
    <%= f.text_field :code, class: "form-input", required: true, placeholder: "Ex: 01, 01-PIQ, 01-DPT" %>
    <p class="text-xs text-gray-500 mt-1">Código único da organização</p>
  </div>

  <div>
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-input", required: true, placeholder: "Nome completo da organização" %>
  </div>

  <div>
    <%= f.label :level, class: "form-label" %>
    <%= f.select :level, Organization::VALID_LEVELS.map { |l| [l.humanize, l] }, { include_hidden: false }, { class: "form-select", required: true } %>
  </div>

  <div>
    <%= f.label :parent_id, class: "form-label" %>
    <%= f.select :parent_id, 
        options_for_select([["Nenhuma (Raiz)"] + @parents.map { |p| [p.name, p.id] }], @organization.parent_id),
        { include_hidden: false },
        { class: "form-select" }
    %>
    <p class="text-xs text-gray-500 mt-1">Organização pai (opcional)</p>
  </div>

  <div>
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-textarea", rows: 3, placeholder: "Descrição da organização" %>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancelar", request.referer || admin_organizations_path, class: "btn btn-secondary" %>
  </div>
<% end %>
