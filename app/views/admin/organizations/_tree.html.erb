<%# Render organization tree %>
<%# locals: orgs, parent_id, depth %>
<% 
  children = orgs.where(parent_id: parent_id)
  return if children.empty?
%>
<ul>
  <% children.order(:level, :code).each do |org| %>
    <li class="py-2">
      <div class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors">
        <!-- Icon based on level -->
        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0">
          <% case org.level %>
          <% when 'root' %>
            <span class="text-lg">🏛</span>
          <% when 'direccao_geral' %>
            <span class="text-lg">🏢</span>
          <% when 'direccao' %>
            <span class="text-sm font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded"><%= org.short_name %></span>
          <% when 'departamento' %>
            <span class="text-sm font-medium text-green-600 bg-green-50 px-2 py-1 rounded"><%= org.code %></span>
          <% when 'seccao' %>
            <span class="text-sm text-gray-600 bg-gray-100 px-2 py-1 rounded"><%= org.code %></span>
          <% when 'piquete' %>
            <span class="text-sm text-purple-600 bg-purple-50 px-2 py-1 rounded">🚔 <%= org.code %></span>
          <% end %>
        </div>
        
        <!-- Name -->
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate"><%= org.name %></p>
          <p class="text-xs text-gray-500"><%= org.level.humanize %></p>
        </div>
        
        <!-- Actions -->
        <div class="flex items-center gap-2">
          <%= link_to admin_organization_path(org), class: "text-gray-400 hover:text-gray-600", title: "Ver" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          <% end %>
          
          <% if can?(:update, org) %>
            <%= link_to edit_admin_organization_path(org), class: "text-gray-400 hover:text-blue-600", title: "Editar", data: { turbo_frame: "_top" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            <% end %>
          <% end %>
          
          <% if can?(:destroy, org) && org.children.empty? %>
            <%= link_to admin_organization_path(org), method: :delete, data: { turbo_confirm: "Tem certeza que deseja eliminar #{org.name}?" }, class: "text-gray-400 hover:text-red-600", title: "Eliminar" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>
      
      <!-- Render children recursively -->
      <% if org.children.any? %>
        <%= render "admin/organizations/tree", orgs: @organizations, parent_id: org.id %>
      <% end %>
    </li>
  <% end %>
</ul>
