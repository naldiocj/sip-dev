<% content_for :page_title, "Diligências" %>

<%= render "shared/breadcrumb" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Diligências</h1>
    <p class="text-sm text-slate-500 mt-1"><%= @diligences.count %> registadas</p>
  </div>
  <% if can?(:DILIGENCIA_CREATE) %>
    <%= link_to new_admin_diligence_path, class: "fb-btn fb-btn-primary", data: { turbo_frame: "_top" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Nova Diligência
    <% end %>
  <% end %>
</div>

<!-- Filters -->
<div class="fb-card mb-6">
  <div class="fb-card-body">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="fb-label">Pesquisar</label>
        <input type="text" id="search-diligence" placeholder="Número..." class="fb-input" onkeyup="filterDiligences()">
      </div>
      <div>
        <label class="fb-label">Estado</label>
        <select id="filter-state" class="fb-select" onchange="filterDiligences()">
          <option value="">Todos</option>
          <option value="agendada">Agendada</option>
          <option value="em_andamento">Em Andamento</option>
          <option value="concluida">Concluída</option>
          <option value="cancelada">Cancelada</option>
        </select>
      </div>
      <div>
        <label class="fb-label">Processo</label>
        <select id="filter-process" class="fb-select" onchange="filterDiligences()">
          <option value="">Todos os processos</option>
          <% @processes.each do |p| %>
            <option value="<%= p.id %>"><%= p.number %></option>
          <% end %>
        </select>
      </div>
      <div class="flex items-end">
        <button type="button" onclick="clearFilters()" class="fb-btn fb-btn-secondary w-full">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          Limpar Filtros
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Diligences Table -->
<div class="fb-card">
  <div class="fb-card-header">
    <h3 class="fb-card-title">Lista de Diligências</h3>
    <span class="fb-badge fb-badge-blue"><%= @diligences.count %></span>
  </div>
  <div class="overflow-x-auto">
    <table class="fb-table">
      <thead>
        <tr>
          <th>Número</th>
          <th>Tipo</th>
          <th>Processo</th>
          <th>Estado</th>
          <th>Data</th>
          <th class="text-right">Acções</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @diligences.each do |d| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="font-medium text-slate-900"><%= d.number %></td>
            <td><%= d.diligencia_type&.name || "—" %></td>
            <td>
              <p class="text-sm text-slate-900"><%= d.process&.number || "—" %></p>
              <p class="text-xs text-slate-500"><%= d.process&.description&.truncate(20) %></p>
            </td>
            <td><%= estado_badge(d.state) %></td>
            <td><%= d.date&.strftime("%d/%m/%Y") %></td>
            <td class="text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to admin_diligence_path(d), class: "fb-btn-icon text-slate-400 hover:text-blue-600", title: "Ver" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                <% end %>
                <%= link_to edit_admin_diligence_path(d), class: "fb-btn-icon text-slate-400 hover:text-blue-600", title: "Editar", data: { turbo_frame: "_top" } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                <% end %>
                <%= link_to admin_diligence_path(d), method: :delete, data: { turbo_confirm: "Tem certeza que deseja eliminar esta diligência?" }, class: "fb-btn-icon text-slate-400 hover:text-red-600", title: "Eliminar" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function filterDiligences() {
    const search = document.getElementById('search-diligence').value.toLowerCase();
    const state = document.getElementById('filter-state').value;
    const process = document.getElementById('filter-process').value;
    
    console.log('Filter:', { search, state, process });
  }
  
  function clearFilters() {
    document.getElementById('search-diligence').value = '';
    document.getElementById('filter-state').value = '';
    document.getElementById('filter-process').value = '';
    filterDiligences();
  }
</script>
