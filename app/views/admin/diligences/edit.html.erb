<% content_for :page_title, "Editar Diligência" %>

<div class="max-w-3xl">
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Diligências", admin_diligences_path, class: "hover:text-gray-900" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <%= link_to @diligence.descricao&.truncate(30) || "Diligência", admin_diligence_path(@diligence), class: "hover:text-gray-900" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <span class="text-gray-900">Editar</span>
  </nav>

  <div class="fb-card">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Editar Diligência</h3>
    </div>
    <div class="fb-card-body">
      <%= render "form" %>
    </div>
  </div>
</div>
