<% content_for :page_title, "#{@user.first_name} #{@user.last_name}" %>

<div class="max-w-4xl">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Utilizadores", admin_users_path, class: "hover:text-gray-900" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <span class="text-gray-900"><%= @user.email %></span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Info -->
    <div class="lg:col-span-2 space-y-6">
      <div class="fb-card">
        <div class="fb-card-header flex items-start justify-between">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-xl font-bold text-blue-600">
              <%= @user.first_name&.first || @user.username&.first || "?" %>
            </div>
            <div>
              <h1 class="text-2xl font-bold text-gray-900"><%= @user.first_name %> <%= @user.last_name %></h1>
              <p class="text-sm text-gray-500">@<%= @user.username %></p>
              <div class="flex items-center gap-2 mt-2">
                <span class="fb-badge fb-badge-<%= @user.status == 'active' ? 'green' : @user.status == 'inactive' ? 'gray' : 'red' %>">
                  <%= @user.status.humanize %>
                </span>
                <% @user.assigned_profiles.each do |profile| %>
                  <span class="fb-badge fb-badge-<%= case profile.code
                    when 'ADMIN' then 'purple'
                    when 'DIRECAO_GERAL' then 'blue'
                    when 'INSTRUTOR' then 'green'
                    when 'PIQUETE' then 'red'
                    else 'gray'
                  end %>"><%= profile.code %></span>
                <% end %>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to edit_admin_user_path(@user), class: "btn btn-secondary", data: { turbo_frame: "_top" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Editar
            <% end %>
            <% if @user.status == 'active' %>
              <%= link_to activate_admin_user_path(@user), method: :post, class: "btn btn-warning" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Desactivar
              <% end %>
            <% elsif @user.status != 'active' %>
              <%= link_to deactivate_admin_user_path(@user), method: :post, class: "btn btn-success" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Activar
              <% end %>
            <% end %>
            <%= link_to admin_user_path(@user), method: :delete, data: { turbo_confirm: "Tem certeza que deseja eliminar #{ @user.first_name } #{ @user.last_name }?" }, class: "btn btn-danger" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              Eliminar
            <% end %>
          </div>
        </div>
        <div class="fb-card-body">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-xs text-gray-500 uppercase">Email</p>
              <p class="text-sm font-medium text-gray-900"><%= @user.email %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase">Username</p>
              <p class="text-sm font-medium text-gray-900"><%= @user.username %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase">Primeiro Nome</p>
              <p class="text-sm font-medium text-gray-900"><%= @user.first_name %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase">Último Nome</p>
              <p class="text-sm font-medium text-gray-900"><%= @user.last_name %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Assignments -->
      <div class="fb-card">
        <div class="fb-card-header">
          <h3 class="font-semibold text-gray-900">Afectações Organizacionais</h3>
        </div>
        <div class="fb-card-body p-0">
          <% if @assignments.any? %>
            <div class="divide-y divide-gray-100">
              <% @assignments.each do |assignment| %>
                <div class="px-4 py-3 flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= assignment.profile&.name %></p>
                    <p class="text-xs text-gray-500"><%= assignment.organization&.name %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-500">Desde <%= assignment.started_at.strftime("%d/%m/%Y") %></p>
                    <% if assignment.ended_at.present? %>
                      <p class="text-xs text-red-500">Até <%= assignment.ended_at.strftime("%d/%m/%Y") %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="px-4 py-8 text-center text-gray-500">
              <p>Nenhuma afectação registada</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Activity -->
      <div class="fb-card">
        <div class="fb-card-header">
          <h3 class="font-semibold text-gray-900">Actividade Recente</h3>
        </div>
        <div class="fb-card-body">
          <p class="text-gray-500 text-sm">O registo de actividade será implementado na Fase 25 (Auditoria).</p>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <div class="fb-card">
        <div class="fb-card-header">
          <h3 class="font-semibold text-gray-900">Informações</h3>
        </div>
        <div class="fb-card-body space-y-3">
          <div>
            <p class="text-xs text-gray-500 uppercase">Criado em</p>
            <p class="text-sm text-gray-900"><%= @user.created_at.strftime("%d/%m/%Y às %H:%M") %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase">Actualizado em</p>
            <p class="text-sm text-gray-900"><%= @user.updated_at.strftime("%d/%m/%Y às %H:%M") %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase">Último Login</p>
            <p class="text-sm text-gray-900"><%= @user.last_login_at&.strftime("%d/%m/%Y às %H:%M") || "Nunca" %></p>
          </div>
        </div>
      </div>

      <%= link_to "← Voltar à lista", admin_users_path, class: "btn btn-ghost w-full" %>
    </div>
  </div>
</div>
