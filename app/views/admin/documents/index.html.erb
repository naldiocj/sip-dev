<% content_for :page_title, "Documentos" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Documentos</h1>
    <p class="text-sm text-gray-500 mt-1">Gestão documental do sistema</p>
  </div>
  <%= link_to new_admin_document_path, class: "btn btn-primary", data: { turbo: false } do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    Novo Documento
  <% end %>
</div>

<!-- Filters -->
<div class="fb-card mb-6">
  <div class="fb-card-body p-4">
    <%= form_with url: admin_documents_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :search, "Pesquisar", class: "label" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Título...", class: "input" %>
      </div>
      <div>
        <%= f.label :status, "Estado", class: "label" %>
        <%= f.select :status,
              {"" => "Todos", "draft" => "Rascunho", "submitted" => "Submetido", "approved" => "Aprovado", "signed" => "Assinado", "archived" => "Arquivado"},
              { include_hidden: false },
              { class: "select", data: { turbo: false } %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "btn btn-primary" %>
        <%= link_to "Limpar", admin_documents_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Documents List -->
<div class="fb-card">
  <div class="fb-card-body p-0">
    <% if @documents.any? %>
      <div class="overflow-x-auto">
        <table class="fb-table">
          <thead>
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Processo</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Upload</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acções</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @documents.each do |doc| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                    <span class="text-sm font-medium text-gray-900"><%= doc.title %></span>
                  </div>
                  <% if doc.description.present? %>
                    <p class="text-xs text-gray-400 mt-1"><%= truncate(doc.description, length: 50) %></p>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <% if doc.process.present? %>
                    <%= link_to doc.process.numero, admin_process_path(doc.process), class: "text-sm text-blue-600 hover:text-blue-700", data: { turbo: false } %>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <%= status_badge(doc.status) %>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-700"><%= doc.uploader&.full_name || "—" %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-gray-600"><%= doc.created_at.strftime("%d/%m/%Y") %></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <%= link_to admin_document_path(doc), class: "btn btn-sm btn-secondary", data: { turbo: false } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  <% end %>
                  <% if doc.file.attached? %>
                    <%= link_to download_admin_document_path(doc), class: "btn btn-sm btn-primary ml-1", data: { turbo: false } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                      </svg>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-4 py-3 border-t border-gray-100">
        <%= paginate @documents %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <p class="mt-2 text-sm text-gray-500">Nenhum documento encontrado</p>
        <%= link_to new_admin_document_path, class: "mt-4 btn btn-primary", data: { turbo: false } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Criar Primeiro Documento
        <% end %>
      </div>
    <% end %>
  </div>
</div>
