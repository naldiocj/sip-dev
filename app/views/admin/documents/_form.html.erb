<%= form_with(model: [:admin, @document], local: true, multipart: true) do |f| %>
  <% if @document.errors.any? %>
    <div class="alert alert-error mb-6">
      <h3 class="font-semibold">Existem <%= @document.errors.count %> erros:</h3>
      <ul class="list-disc list-inside mt-2">
        <% @document.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="fb-card mb-6">
    <div class="fb-card-header">
      <h3 class="font-semibold text-gray-900">Informações do Documento</h3>
    </div>
    <div class="fb-card-body space-y-4">
      <div>
        <%= f.label :title, "Título", class: "label" %>
        <%= f.text_field :title, class: "input", required: true, placeholder: "Título do documento" %>
      </div>

      <div>
        <%= f.label :description, "Descrição", class: "label" %>
        <%= f.text_area :description, rows: 3, class: "textarea", placeholder: "Descrição do documento" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :process_id, "Processo (opcional)", class: "label" %>
          <%= f.collection_select :process_id, @processes, :id, -> { |p| "#{p.numero}/#{p.ano} — #{p.titulo}" }, { include_hidden: true }, { class: "select" } %>
        </div>
        <div>
          <%= f.label :status, "Estado", class: "label" %>
          <%= f.select :status,
                { "Rascunho" => "draft", "Submetido" => "submitted", "Aprovado" => "approved", "Assinado" => "signed", "Arquivado" => "archived" },
                { selected: @document.status.presence || "draft" },
                { class: "select" } %>
        </div>
      </div>

      <div>
        <%= f.label :file, "Ficheiro", class: "label" %>
        <%= f.file_field :file, class: "file-input" %>
        <% if @document.file.attached? %>
          <p class="text-xs text-gray-500 mt-1">
            Ficheiro actual: <%= @document.file.filename %>
            <%= link_to "Remover", "#", class: "text-red-600 hover:text-red-700", data: { turbo: false } %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", admin_documents_path, class: "btn btn-secondary" %>
    <%= f.submit @document.new_record? ? "Criar Documento" : "Guardar Alterações", class: "btn btn-primary" %>
  </div>
<% end %>
