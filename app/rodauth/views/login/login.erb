<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — SIP</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            sic: {
              50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
              400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
              800: '#075985', 900: '#0c4a6e', 950: '#082f49',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans antialiased h-screen overflow-hidden">
  <div class="flex h-full">

    <!-- Left Panel — Branding -->
    <div class="hidden lg:flex lg:w-1/2 relative bg-sic-950 overflow-hidden">
      <!-- Background pattern -->
      <div class="absolute inset-0 opacity-10">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)"/>
        </svg>
      </div>

      <!-- Decorative gradient orbs -->
      <div class="absolute top-0 left-0 w-96 h-96 bg-sic-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-sic-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 translate-x-1/2 translate-y-1/2"></div>

      <!-- Content -->
      <div class="relative z-10 flex flex-col justify-between p-16 w-full">
        <!-- Logo -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-sic-400 to-sic-600 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <span class="text-white text-xl font-bold tracking-tight">SIP</span>
        </div>

        <!-- Center content -->
        <div class="space-y-6">
          <h1 class="text-4xl font-bold text-white leading-tight">
            Sistema de<br>
            <span class="text-sic-400">Ivory e Processos</span>
          </h1>
          <p class="text-slate-400 text-lg max-w-md leading-relaxed">
            Plataforma integrada para gestão de processos de investigação criminal da SIC Angola.
          </p>
        </div>

        <!-- Bottom stats -->
        <div class="flex gap-12">
          <div>
            <div class="text-2xl font-bold text-white">SIC</div>
            <div class="text-sm text-slate-500 mt-1">Segurança Interna</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">Angola</div>
            <div class="text-sm text-slate-500 mt-1">República de</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel — Login Form -->
    <div class="w-full lg:w-1/2 flex items-center justify-center bg-slate-50 px-6 py-12">
      <div class="w-full max-w-md">

        <!-- Mobile logo -->
        <div class="lg:hidden flex items-center gap-3 mb-8 justify-center">
          <div class="w-10 h-10 bg-gradient-to-br from-sic-500 to-sic-700 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <span class="text-slate-900 text-xl font-bold">SIP</span>
            <span class="block text-xs text-slate-500">SIC Angola</span>
          </div>
        </div>

        <!-- Header -->
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-slate-900">Bem-vindo de volta</h2>
          <p class="text-slate-500 mt-1">Inicie sessão para continuar</p>
        </div>

        <!-- Error message -->
        <% if locals[:error] %>
          <div class="fb-alert fb-alert-error mb-6 flex items-center gap-3">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><%= locals[:error] %></span>
          </div>
        <% end %>

        <!-- Login Form -->
        <form method="POST" action="<%= locals[:action] %>" class="space-y-5">
          <!-- Login field -->
          <div>
            <label for="login" class="fb-label">Email ou utilizador</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <input type="text" name="login" id="login" required
                class="fb-input ps-10"
                placeholder="O seu email ou utilizador"
                value="<%= locals.fetch(:login, '') %>">
            </div>
          </div>

          <!-- Password field -->
          <div>
            <label for="password" class="fb-label">Palavra-passe</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <input type="password" name="password" id="password" required
                class="fb-input ps-10"
                placeholder="••••••••">
            </div>
          </div>

          <!-- Remember me + Forgot password -->
          <div class="flex items-center justify-between">
            <% if locals[:remember] %>
              <div class="flex items-center">
                <input type="checkbox" name="remember" id="remember" value="1"
                  class="w-4 h-4 text-sic-600 border-slate-300 rounded focus:ring-sic-500 cursor-pointer">
                <label for="remember" class="ml-2 text-sm text-slate-600 cursor-pointer select-none">Lembrar-me</label>
              </div>
            <% end %>
            <a href="<%= rodauth.reset_password_url %>" class="text-sm font-medium text-sic-600 hover:text-sic-700 transition-colors">
              Esqueceu-se da palavra-passe?
            </a>
          </div>

          <!-- Submit button -->
          <button type="submit" class="fb-btn fb-btn-primary w-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            Entrar
          </button>
        </form>

        <!-- Divider -->
        <div class="flex items-center gap-3 my-6">
          <div class="flex-1 h-px bg-slate-200"></div>
          <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">ou</span>
          <div class="flex-1 h-px bg-slate-200"></div>
        </div>

        <!-- Social login -->
        <div class="grid grid-cols-2 gap-3">
          <button type="button" class="fb-btn fb-btn-secondary gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Google
          </button>
          <button type="button" class="fb-btn fb-btn-secondary gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
          </button>
        </div>

        <!-- Footer links -->
        <p class="mt-8 text-center text-sm text-slate-500">
          Não tem uma conta?
          <a href="<%= rodauth.create_account_url %>" class="font-semibold text-sic-600 hover:text-sic-700 transition-colors">
            Criar conta
          </a>
        </p>

        <!-- Footer credit -->
        <p class="mt-8 text-center text-xs text-slate-400">
          © 2025 SIP — Serviço de Investigação Criminal
        </p>
      </div>
    </div>
  </div>
</body>
</html>
